{
  "name": "peers-touch-monorepo",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "mono:check": "pnpm -r --if-present run check",
    "mono:lint": "pnpm -r --if-present run lint",
    "mono:test": "pnpm -r --if-present run test",
    "mono:build": "pnpm -r --if-present run build",
    "desktop:dev": "pnpm --filter @peers-touch/app-desktop run dev",
    "desktop:build": "pnpm --filter @peers-touch/app-desktop run build",
    "mobile:check": "pnpm --filter @peers-touch/app-mobile run check",
    "mobile:dev": "pnpm --filter @peers-touch/app-mobile run dev",
    "mobile:dev:ios": "pnpm --filter @peers-touch/app-mobile run tauri:ios:dev",
    "mobile:build:ios": "pnpm --filter @peers-touch/app-mobile run tauri:ios:build",
    "applets:build": "node packages/applets/build.js",
    "applets:dev": "node packages/applets/dev-sync.js",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "husky": "^9.1.7",
    "@vitejs/plugin-react": "^5.1.1",
    "vite": "^7.3.1"
  }
}
