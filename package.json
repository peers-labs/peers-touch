{
  "name": "peers-touch-monorepo",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "mono:check": "pnpm -r --if-present run check",
    "mono:lint": "pnpm -r --if-present run lint",
    "mono:test": "pnpm -r --if-present run test",
    "mono:build": "pnpm -r --if-present run build",
    "desktop:dev": "pnpm --filter @peers-touch/app-desktop run dev",
    "desktop:build": "pnpm --filter @peers-touch/app-desktop run build",
    "mobile:check": "pnpm --filter @peers-touch/app-mobile run check",
    "mobile:dev": "pnpm --filter @peers-touch/app-mobile run dev",
    "mobile:dev:ios": "pnpm --filter @peers-touch/app-mobile run tauri:ios:dev",
    "mobile:build:ios": "pnpm --filter @peers-touch/app-mobile run tauri:ios:build",
    "applets:build": "node packages/applets/build.js",
    "applets:dev": "node packages/applets/dev-sync.js",
    "applet:validate": "pnpm --filter @peers-touch/applet-contract run build && node tooling/scripts/applet-validate.mjs",
    "applet:contract-schema": "pnpm --filter @peers-touch/applet-contract run schema",
    "applet:contract-test": "pnpm --filter @peers-touch/applet-contract run build && node tooling/scripts/applet-contract-test.mjs",
    "applet:desktop-smoke": "pnpm --filter @peers-touch/applet-contract run build && node tooling/scripts/applet-desktop-smoke.mjs",
    "applet:desktop-e2e": "pnpm --filter @peers-touch/applet-contract run build && node tooling/scripts/applet-desktop-e2e.mjs applet-readiness-evidence/package/generic-complex-applet",
    "applet:desktop-runtime-gate": "pnpm --filter @peers-touch/applet-sdk run build && node tooling/scripts/applet-desktop-runtime-gate.mjs",
    "applet:desktop-product-host-gate": "pnpm --filter @peers-touch/applet-sdk run build && node tooling/scripts/applet-desktop-product-host-gate.mjs",
    "applet:desktop-product-host-real-gateway-gate": "pnpm --filter @peers-touch/applet-sdk run build && node tooling/scripts/applet-desktop-product-host-gate.mjs --real-http-gateway",
    "applet:desktop-product-shell-gate": "pnpm --filter @peers-touch/applet-sdk run build && node tooling/scripts/applet-desktop-product-host-gate.mjs --shell-route",
    "applet:desktop-product-shell-real-gateway-gate": "pnpm --filter @peers-touch/applet-sdk run build && node tooling/scripts/applet-desktop-product-host-gate.mjs --shell-route --real-http-gateway",
    "applet:desktop-product-window-gate": "node tooling/scripts/applet-desktop-product-window-gate.mjs",
    "applet:desktop-lifecycle-smoothness-gate": "node tooling/scripts/applet-desktop-lifecycle-smoothness-gate.mjs",
    "applet:web-host-runtime-gate": "pnpm --filter @peers-touch/applet-contract run build && pnpm --filter @peers-touch/applet-sdk run build && node tooling/scripts/applet-web-host-runtime-gate.mjs",
    "applet:production-web-host-gate": "pnpm --filter @peers-touch/applet-contract run build && pnpm --filter @peers-touch/applet-sdk run build && node tooling/scripts/applet-production-web-host-gate.mjs",
    "applet:mobile-native-manifest-gate": "pnpm --filter @peers-touch/applet-contract run build && pnpm --filter @peers-touch/applet-sdk run build && node tooling/scripts/applet-mobile-native-manifest-gate.mjs",
    "applet:ios-lynx-runtime-e2e": "node tooling/scripts/applet-ios-lynx-runtime-e2e.mjs",
    "applet:android-lynx-runtime-e2e": "node tooling/scripts/applet-android-lynx-runtime-e2e.mjs",
    "applet:desktop-http-gateway-gate": "node tooling/scripts/applet-desktop-http-gateway-gate.mjs",
    "applet:publish": "node tooling/scripts/applet-store-cli.mjs publish",
    "applet:install": "node tooling/scripts/applet-store-cli.mjs install",
    "applet:revoke": "node tooling/scripts/applet-store-cli.mjs revoke",
    "applet:station-backed-launch-gate": "node tooling/scripts/applet-station-backed-launch-gate.mjs",
    "applet:desktop-package-gate": "pnpm applets:build && node tooling/scripts/applet-desktop-package-gate.mjs",
    "applet:desktop-packaged-assets-gate": "pnpm applets:build && pnpm --filter @peers-touch/app-desktop run build && node tooling/scripts/applet-desktop-packaged-assets-gate.mjs",
    "applet:desktop-tauri-bundle-gate": "pnpm --filter @peers-touch/applet-contract run build && pnpm applets:build && CI=false pnpm --filter @peers-touch/app-desktop run tauri:build && node tooling/scripts/applet-desktop-tauri-bundle-gate.mjs",
    "applet:external-producer-certification-gate": "node tooling/scripts/applet-external-producer-certification-gate.mjs",
    "applet:l3-candidate-audit": "node tooling/scripts/applet-l3-release-audit.mjs --candidate-only",
    "applet:l3-release-audit": "node tooling/scripts/applet-l3-release-audit.mjs",
    "applet:product-capability-service-gate": "node tooling/scripts/applet-product-capability-service-gate.mjs",
    "applet:platform-check-gate": "node tooling/scripts/applet-platform-check-gate.mjs",
    "applet:parity-gate": "pnpm --filter @peers-touch/applet-contract run build && pnpm --filter @peers-touch/applet-sdk run build && node tooling/scripts/applet-parity-gate.mjs",
    "applet:developer-flow-gate": "pnpm --filter @peers-touch/applet-contract run build && pnpm --filter @peers-touch/applet-sdk run build && node tooling/scripts/applet-developer-flow-gate.mjs",
    "applet:sdk-adapter-test": "pnpm --filter @peers-touch/applet-contract run build && pnpm --filter @peers-touch/applet-sdk run build && node tooling/scripts/applet-sdk-adapter-test.mjs",
    "applet:forbidden-producer-scan": "node tooling/scripts/applet-forbidden-producer-scan.mjs",
    "applet:create-generic-package": "node tooling/scripts/create-generic-complex-applet.mjs",
    "applet:create-official": "node tooling/scripts/create-official-applet.mjs",
    "applet:official-contract-gate": "node tooling/scripts/applet-official-contract-gate.mjs",
    "applet:official-skill-discovery-gate": "node tooling/scripts/applet-official-skill-discovery-gate.mjs",
    "applet:note-frontend-sdk-gate": "node tooling/scripts/applet-note-frontend-sdk-gate.mjs",
    "applet:note-forbidden-scan": "node tooling/scripts/applet-note-frontend-sdk-gate.mjs --forbidden-scan",
    "applet:note-desktop-injection-gate": "pnpm applets:build && pnpm --filter @peers-touch/app-desktop run test:applet -- AppletManager.test.ts && node tooling/scripts/applet-note-desktop-injection-gate.mjs",
    "applet:note-desktop-live-smoke": "pnpm applets:build && node tooling/scripts/applet-note-desktop-live-smoke.mjs",
    "applet:note-real-product-gate": "node tooling/scripts/applet-note-real-product-gate.mjs",
    "applet:note-reload-persistence-gate": "node tooling/scripts/applet-note-reload-persistence-gate.mjs",
    "applet:note-mobile-contract-gate": "node tooling/scripts/applet-note-mobile-contract-gate.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "husky": "^9.1.7",
    "@vitejs/plugin-react": "^5.1.1",
    "vite": "^7.3.1"
  }
}
