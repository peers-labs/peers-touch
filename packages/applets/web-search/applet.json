{
  "id": "web-search",
  "name": "Web Search",
  "version": "1.0.0",
  "description": "Web search and information retrieval",
  "author": "Peers Touch",
  "icon": "assets/icon.png",
  "minPlatformVersion": "0.1.0",
  "targets": ["standalone"],
  "entries": {
    "lynx": "index.html",
    "standalone": "index.html"
  },
  "load": {
    "standalone": {
      "type": "web-spa",
      "entry": "index.html"
    }
  },
  "bridge": {
    "protocol": "peers-touch.applet.bridge",
    "version": "1.0.0"
  },
  "permissions": [
    "app.getContext",
    "app.getLaunchOptions",
    "lifecycle.reportReady",
    "storage.get",
    "storage.set",
    "network.request",
    "tasks.start"
  ],
  "capabilities": [],
  "services": [
    {
      "id": "station-api",
      "kind": "http",
      "binding": "station-resolved",
      "allowedMethods": ["POST"],
      "allowedPaths": ["/api/v1/search"],
      "streaming": false
    }
  ],
  "skills": []
}
