{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Peers Touch Desktop",
  "version": "0.1.0",
  "identifier": "com.peers.touch.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3210",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Peers Touch Desktop",
        "decorations": true,
        "width": 1200,
        "height": 800,
        "minWidth": 860,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "peers-touch"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icon-source.png"
    ]
  }
}
