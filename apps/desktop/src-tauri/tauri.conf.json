{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Peers",
  "version": "0.1.0",
  "identifier": "com.peers.touch.desktop.dev2",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3210",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Peers",
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "maximizable": true,
        "width": 360,
        "height": 640,
        "minWidth": 320,
        "minHeight": 440,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/peers-labs/peers-touch/releases/latest/download/latest.json"
      ]
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "peers-touch"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../packages/locales/": "i18n/"
    }
  }
}
