{
  "id": "peers.atelier",
  "name": "Atelier",
  "description": "Personal Agent workbench powered by the peers-touch orchestration layer.",
  "author": "Peers Touch",
  "version": "0.1.0",
  "icon": "assets/icon.png",
  "minPlatformVersion": "0.1.0",
  "targets": [
    "desktop",
    "web"
  ],
  "entries": {
    "lynx": "main.lynx.bundle"
  },
  "load": {
    "desktop": {
      "type": "lynx-web",
      "entry": "main.lynx.bundle"
    },
    "web": {
      "type": "lynx-web",
      "entry": "main.lynx.bundle"
    }
  },
  "bridge": {
    "protocol": "peers-touch.applet.bridge",
    "version": "1.0.0"
  },
  "permissions": [
    "app.getContext",
    "app.getLaunchOptions",
    "lifecycle.reportReady",
    "network.request",
    "events.subscribe",
    "events.unsubscribe",
    "events.poll",
    "telemetry.track",
    "telemetry.reportError",
    "atelier.workspace.load",
    "atelier.project.createFromGoal",
    "atelier.message.send",
    "atelier.escalation.resolve",
    "atelier.task.setStatus",
    "atelier.task.purge",
    "atelier.provider.capabilities",
    "atelier.feedback.submit",
    "atelier.memory.confirmCandidate",
    "atelier.feedback.confirmRerun",
    "atelier.workspace.open",
    "atelier.artifact.body.fetch",
    "atelier.artifact.preview.open",
    "atelier.events.subscribe"
  ],
  "capabilities": [
    "atelier"
  ],
  "services": [
    {
      "id": "atelier",
      "kind": "http",
      "binding": "station-resolved",
      "allowedMethods": [
        "GET",
        "POST",
        "PATCH",
        "DELETE"
      ],
      "allowedPaths": [
        "/v1/workspace",
        "/v1/projects",
        "/v1/projects/*",
        "/v1/messages",
        "/v1/escalations:resolve",
        "/v1/tasks",
        "/v1/tasks/*"
      ],
      "publicPathPrefix": "/v1",
      "stationPathPrefix": "/applets/atelier/v1",
      "streaming": true
    }
  ],
  "serviceDependencies": {
    "atelier": {
      "kind": "station-subserver",
      "required": true
    },
    "station-agent-subserver": {
      "kind": "station-subserver",
      "required": true
    }
  },
  "skills": [],
  "platformPermissions": [
    "network:service:atelier",
    "events:applet",
    "telemetry:track",
    "agent:atelier-projection"
  ],
  "integrity": {
    "algorithm": "sha256",
    "files": {
      "main.lynx.bundle": "sha256:pending-atelier-bundle"
    }
  }
}
