{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Peers",
  "version": "0.1.0",
  "identifier": "com.peers.touch.mobile",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Peers",
        "width": 390,
        "height": 844,
        "minWidth": 320,
        "minHeight": 568,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost chat-file: http: https: ws: wss:; img-src 'self' asset: chat-file: http://chat-file.localhost http://asset.localhost data: blob:; media-src 'self' chat-file: http://chat-file.localhost; worker-src 'self' blob:; font-src 'self' data: blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": [
            "peers-touch"
          ],
          "host": "oauth",
          "path": [
            "/callback"
          ],
          "appLink": false
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icon-source.png"
    ]
  }
}
