---
import Base from '../../layouts/Base.astro';
import { getDict, localeParams, isLocale, DEFAULT_LOCALE, type Locale } from '../../i18n';

export function getStaticPaths() {
  return localeParams();
}

const { lang } = Astro.params;
const locale: Locale = isLocale(lang) ? lang : DEFAULT_LOCALE;
const t = getDict(locale);
---

<Base locale={locale} page="community" currentPath={Astro.url.pathname}>
  <section class="pt-shell page-head">
    <p class="pt-eyebrow">{t.community.eyebrow}</p>
    <h1 class="page-head__title">{t.community.title}</h1>
    <p class="page-head__subtitle">{t.community.subtitle}</p>
  </section>

  <section class="pt-shell ways">
    <h2 class="ways__title">{t.community.waysTitle}</h2>
    <div class="ways__track">
      {t.community.ways.map((way, index) => (
        <a
          class="way pt-indexed-card pt-indexed-card--with-tip"
          href={`#guide-${way.id}`}
          data-community-guide
          aria-label={`${way.title}. ${t.community.comingSoon}`}
        >
          <div class="pt-indexed-card__head">
            <span class="pt-indexed-card__number" aria-hidden="true">{index + 1}</span>
            <h3 class="pt-indexed-card__title">{way.title}</h3>
          </div>
          <p class="pt-indexed-card__body">{way.body}</p>
          <span class="pt-indexed-card__tip" aria-live="polite">{t.community.comingSoon}</span>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  .page-head {
    padding-block: clamp(40px, 5vw, 56px) var(--pt-space-xl);
  }
  .page-head__title {
    max-width: 520px;
    font-size: 44.8px;
    font-weight: 800;
    margin-top: var(--pt-space-xs);
    line-height: 53.76px;
    letter-spacing: 0;
  }
  .page-head__subtitle {
    max-width: 32em;
    font-size: 17.6px;
    color: var(--pt-text-secondary);
    margin-top: var(--pt-space-sm);
    line-height: 1.7;
  }

  .ways {
    margin-top: var(--pt-space-lg);
  }
  .ways__title {
    font-size: 32px;
    font-weight: 700;
    margin-bottom: var(--pt-space-lg);
    line-height: 38.4px;
    letter-spacing: 0;
  }
  .ways__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(232px, 1fr);
    grid-template-rows: 1fr;
    gap: var(--pt-space-md);
    overflow-x: auto;
    margin-top: calc(0px - var(--pt-space-md));
    margin-inline: calc(0px - var(--pt-space-md));
    padding-top: var(--pt-space-md);
    padding-inline: var(--pt-space-md);
    padding-bottom: var(--pt-space-xs);
    scroll-snap-type: x proximity;
    overscroll-behavior-inline: contain;
    scrollbar-color: transparent transparent;
    scrollbar-width: thin;
  }
  .ways__track::-webkit-scrollbar {
    height: 6px;
  }
  .ways__track::-webkit-scrollbar-track {
    background: transparent;
  }
  .ways__track::-webkit-scrollbar-thumb {
    border-radius: var(--pt-radius-full);
    background: transparent;
  }
  .ways__track:hover {
    scrollbar-color: rgba(38, 44, 76, 0.3) transparent;
  }
  .ways__track:hover::-webkit-scrollbar-thumb {
    background: rgba(38, 44, 76, 0.3);
  }
  .way {
    min-height: 252px;
    scroll-snap-align: start;
  }

  @media (max-width: 720px) {
    .page-head {
      padding-block: var(--pt-space-xl);
    }
    .page-head__title {
      font-size: 36px;
      line-height: 43.2px;
    }
    .page-head__subtitle {
      font-size: 16px;
    }
    .ways__title {
      font-size: 28px;
      line-height: 33.6px;
    }
    .ways__track {
      grid-auto-columns: minmax(272px, 82vw);
    }
  }
</style>

<script>
  const bindCommunityGuides = () => {
    document.querySelectorAll<HTMLAnchorElement>('[data-community-guide]').forEach((guide) => {
      if (guide.dataset.bound === 'true') return;
      guide.dataset.bound = 'true';

      let hideTimer: number | undefined;
      const showTip = () => {
        guide.dataset.open = 'true';
        window.clearTimeout(hideTimer);
        hideTimer = window.setTimeout(() => {
          delete guide.dataset.open;
        }, 1800);
      };

      guide.addEventListener('click', (event) => {
        event.preventDefault();
        showTip();
      });
      guide.addEventListener('keydown', (event) => {
        if (event.key !== 'Enter' && event.key !== ' ') return;
        event.preventDefault();
        showTip();
      });
    });
  };

  document.addEventListener('astro:page-load', bindCommunityGuides);
  bindCommunityGuides();
</script>
