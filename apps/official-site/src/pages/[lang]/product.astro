---
import Base from '../../layouts/Base.astro';
import HowItWorksExperience from '../../components/HowItWorksExperience.astro';
import {
  getDict,
  localeParams,
  localePath,
  isLocale,
  DEFAULT_LOCALE,
  type Locale,
} from '../../i18n';

export function getStaticPaths() {
  return localeParams();
}

const { lang } = Astro.params;
const locale: Locale = isLocale(lang) ? lang : DEFAULT_LOCALE;
const t = getDict(locale);
---

<Base locale={locale} page="product" currentPath={Astro.url.pathname}>
  <HowItWorksExperience
    locale={locale}
    product={t.product}
    roadmapHref={localePath(locale, 'roadmap')}
  />
</Base>
