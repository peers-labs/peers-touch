---
import Base from '../../layouts/Base.astro';
import AtlasPreview from '../../components/AtlasPreview.astro';
import type { Locale } from '../../i18n';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'zh' } }];
}

const locale = Astro.params.lang as Locale;
---

<Base locale={locale} page="architecture" currentPath={`/${locale}/architecture`}>
  <AtlasPreview locale={locale} />
</Base>
