---
interface ProductCopy {
  eyebrow: string;
  title: string;
  subtitle: string;
  network: {
    eyebrow: string;
    title: string;
    note: string;
    points: Array<{ title: string; body: string }>;
  };
  layers: {
    eyebrow: string;
    title: string;
    note: string;
    items: Array<{ name: string; tag: string; body: string }>;
  };
  agents: {
    eyebrow: string;
    title: string;
    note: string;
    points: Array<{ title: string; body: string }>;
  };
  capabilities: {
    title: string;
    items: Array<{ title: string; status: string; body: string }>;
  };
}

interface Props {
  locale: 'en' | 'zh';
  product: ProductCopy;
  roadmapHref: string;
}

const { locale, product: p, roadmapHref } = Astro.props;
const ui =
  locale === 'zh'
    ? {
        heroSignal: '真实产品形态 · Desktop + Mobile',
        ownershipIndex: '01 · 归属',
        ownershipTitle: '你的社交生活，有自己的家。',
        ownershipBody:
          '身份、关系、消息与内容归于你选择的 Station。你可以自己运行，也可以加入信任的社区；无论由谁托管，边界始终清楚。',
        stationSignal: '真实产品形态 · Station Dashboard',
        networkIndex: '02 · 互联',
        networkTitle: '不在同一个 Station，也能自然相见。',
        networkBody:
          '联系人会标明 Home Station 与 Federation 来源。关注、聊天、分享和群组可以跨 Station 发生，产品里看到的是人，不是协议负担。',
        networkSignal: '真实产品形态 · Desktop Contacts + Mobile Chat',
        agentIndex: '03 · 个人 Agent',
        agentTitle: '你的个人 Agent，由你定义。',
        agentBody:
          '选择模型、上下文、工具和权限。Agent 使用你允许的数据，在执行外部动作前向你确认。',
        agentSignal: '真实产品形态 · Desktop Agent Module',
        capabilityEyebrow: '正在形成的产品能力',
        closingTitle: '各自拥有，彼此连接。',
        closingBody: '人与 Agent，共同生活在一张没有平台中心的网络里。',
        roadmap: '查看路线图',
      }
    : {
        heroSignal: 'Real product surfaces · Desktop + Mobile',
        ownershipIndex: '01 · Ownership',
        ownershipTitle: 'Your social life has a home of its own.',
        ownershipBody:
          'Identity, relationships, messages, and content live on the Station you choose. Run it yourself or join a community you trust; the boundary stays explicit.',
        stationSignal: 'Real product surface · Station Dashboard',
        networkIndex: '02 · Federation',
        networkTitle: 'Different Stations, one natural conversation.',
        networkBody:
          'Contacts expose their Home Station and Federation. Following, messaging, sharing, and groups cross Station boundaries without turning protocols into product burden.',
        networkSignal: 'Real product surfaces · Desktop Contacts + Mobile Chat',
        agentIndex: '03 · Personal Agent',
        agentTitle: 'A personal Agent, defined by you.',
        agentBody:
          'Choose its model, context, tools, and permissions. It works with data you allow and asks before taking external action.',
        agentSignal: 'Real product surface · Desktop Agent Module',
        capabilityEyebrow: 'The product taking shape',
        closingTitle: 'Owned independently. Connected openly.',
        closingBody: 'People and Agents share one network without a platform at its center.',
        roadmap: 'View roadmap',
      };
---

<svg class="hi-symbols" aria-hidden="true">
  <symbol id="hi-search" viewBox="0 0 24 24">
    <path d="m21 21-4.35-4.35"></path><circle cx="11" cy="11" r="8"></circle>
  </symbol>
  <symbol id="hi-message" viewBox="0 0 24 24">
    <path d="M3 16.5a9 9 0 1 1 4 4L2 22l1-5.5Z"></path>
  </symbol>
  <symbol id="hi-contact" viewBox="0 0 24 24">
    <rect x="3" y="4" width="18" height="18" rx="2"></rect><circle cx="12" cy="11" r="3"></circle>
    <path d="M7 21v-1a4 4 0 0 1 4-4h2a4 4 0 0 1 4 4v1"></path>
  </symbol>
  <symbol id="hi-bot" viewBox="0 0 24 24">
    <rect x="4" y="8" width="16" height="12" rx="2"></rect><path d="M12 8V4H8"></path>
    <path d="M8 13h.01M16 13h.01M9 17h6"></path>
  </symbol>
  <symbol id="hi-plus" viewBox="0 0 24 24"><path d="M5 12h14M12 5v14"></path></symbol>
  <symbol id="hi-phone" viewBox="0 0 24 24">
    <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.4 19.4 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8 10a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2Z"></path>
  </symbol>
  <symbol id="hi-video" viewBox="0 0 24 24">
    <rect x="2" y="6" width="14" height="12" rx="2"></rect><path d="m16 10 6-3v10l-6-3"></path>
  </symbol>
  <symbol id="hi-more" viewBox="0 0 24 24">
    <circle cx="5" cy="12" r="1"></circle><circle cx="12" cy="12" r="1"></circle><circle cx="19" cy="12" r="1"></circle>
  </symbol>
  <symbol id="hi-smile" viewBox="0 0 24 24">
    <circle cx="12" cy="12" r="10"></circle><path d="M8 14s1.5 2 4 2 4-2 4-2M9 9h.01M15 9h.01"></path>
  </symbol>
  <symbol id="hi-paperclip" viewBox="0 0 24 24">
    <path d="m16 6-8.4 8.6a2 2 0 0 0 2.8 2.8L18.8 8.8a4 4 0 1 0-5.6-5.6l-8.4 8.5a6 6 0 1 0 8.5 8.5l7-7.1"></path>
  </symbol>
  <symbol id="hi-image" viewBox="0 0 24 24">
    <rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-5-5L5 21"></path>
  </symbol>
  <symbol id="hi-mic" viewBox="0 0 24 24">
    <rect x="9" y="2" width="6" height="13" rx="3"></rect><path d="M5 10v2a7 7 0 0 0 14 0v-2M12 19v3"></path>
  </symbol>
  <symbol id="hi-send" viewBox="0 0 24 24">
    <path d="m22 2-7 20-4-9-9-4Z"></path><path d="M22 2 11 13"></path>
  </symbol>
  <symbol id="hi-arrow-left" viewBox="0 0 24 24"><path d="m12 19-7-7 7-7M19 12H5"></path></symbol>
  <symbol id="hi-lock" viewBox="0 0 24 24">
    <rect x="3" y="10" width="18" height="12" rx="2"></rect><path d="M7 10V7a5 5 0 0 1 10 0v3"></path>
  </symbol>
  <symbol id="hi-settings" viewBox="0 0 24 24">
    <circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1-2.8 2.8-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.6v.2h-4V21a1.7 1.7 0 0 0-1-1.6 1.7 1.7 0 0 0-1.9.3l-.1.1L4.2 17l.1-.1a1.7 1.7 0 0 0 .3-1.9A1.7 1.7 0 0 0 3 14H2.8v-4H3a1.7 1.7 0 0 0 1.6-1 1.7 1.7 0 0 0-.3-1.9L4.2 7 7 4.2l.1.1A1.7 1.7 0 0 0 9 4.6a1.7 1.7 0 0 0 1-1.6v-.2h4V3a1.7 1.7 0 0 0 1 1.6 1.7 1.7 0 0 0 1.9-.3l.1-.1L19.8 7l-.1.1a1.7 1.7 0 0 0-.3 1.9 1.7 1.7 0 0 0 1.6 1h.2v4H21a1.7 1.7 0 0 0-1.6 1Z"></path>
  </symbol>
</svg>

<section class="hi-hero pt-shell">
  <div class="hi-hero-copy">
    <p class="pt-eyebrow">{p.eyebrow}</p>
    <h1>{p.title}</h1>
    <p>{p.subtitle}</p>
  </div>
  <p class="hi-source"><span></span>{ui.heroSignal}</p>

  <div class="hi-hero-stage" aria-label="Peers-Touch Desktop and Mobile chat">
    <div class="hi-desktop-window">
      <div class="hi-desktop-shell">
        <aside class="hi-global-rail">
          <span class="hi-avatar hi-avatar--self"><img src="/avatar-alice.webp" alt="Alex Chen" /></span>
          <button aria-label="Search"><svg class="hi-icon"><use href="#hi-search"></use></svg></button>
          <span class="hi-rail-divider"></span>
          <button class="active" aria-label="Chat"><svg class="hi-icon"><use href="#hi-message"></use></svg></button>
          <button aria-label="Agent"><svg class="hi-icon"><use href="#hi-bot"></use></svg></button>
          <span class="hi-rail-spacer"></span>
          <button aria-label="Settings"><svg class="hi-icon"><use href="#hi-settings"></use></svg></button>
        </aside>

        <aside class="hi-chat-rail">
          <button class="active" aria-label="Chat"><svg class="hi-icon"><use href="#hi-message"></use></svg></button>
          <button aria-label="Contacts"><svg class="hi-icon"><use href="#hi-contact"></use></svg></button>
        </aside>

        <aside class="hi-session-list">
          <header><strong>Messages</strong><button aria-label="New conversation"><svg class="hi-icon hi-icon--small"><use href="#hi-plus"></use></svg></button></header>
          <div class="hi-session-search"><svg class="hi-icon hi-icon--small"><use href="#hi-search"></use></svg><span>Search</span></div>
          <article class="hi-session active">
            <span class="hi-avatar hi-avatar--group"><img src="/avatar-alice.webp" alt="" /><img src="/avatar-emma.webp" alt="" /></span>
            <div><strong>Engineering Team</strong><span>Sarah: Let me check the logs</span></div><time>2m</time>
          </article>
          <article class="hi-session">
            <span class="hi-avatar"><img src="/avatar-sarah.webp" alt="Sarah Kim" /></span>
            <div><strong>Sarah Kim</strong><span>Sounds good, see you tomorrow!</span></div><time>5m</time>
          </article>
          <article class="hi-session">
            <span class="hi-avatar hi-avatar--group"><img src="/avatar-emma.webp" alt="" /><img src="/avatar-sarah.webp" alt="" /></span>
            <div><strong>Design Review</strong><span>Emma shared a file</span></div><time>15m</time>
          </article>
        </aside>

        <section class="hi-chat">
          <header class="hi-chat-head">
            <div><strong>Engineering Team</strong><span>7 members · End-to-end encrypted</span></div>
            <div>
              <button aria-label="Search messages"><svg class="hi-icon"><use href="#hi-search"></use></svg></button>
              <button aria-label="Voice call"><svg class="hi-icon"><use href="#hi-phone"></use></svg></button>
              <button aria-label="Video call"><svg class="hi-icon"><use href="#hi-video"></use></svg></button>
              <button aria-label="More"><svg class="hi-icon"><use href="#hi-more"></use></svg></button>
            </div>
          </header>
          <div class="hi-chat-stream">
            <div class="hi-message">
              <span class="hi-avatar hi-avatar--small"><img src="/avatar-emma.webp" alt="Emma Wang" /></span>
              <div><small>Emma Wang</small><p>The new build is ready for testing.</p><time>10:24</time></div>
            </div>
            <div class="hi-message mine">
              <div><p>I found a memory leak in the WebSocket handler. Looking into it.</p><time>10:26 · Read</time></div>
            </div>
            <div class="hi-system-line">Sarah joined from the Singapore Station.</div>
            <div class="hi-message">
              <span class="hi-avatar hi-avatar--small"><img src="/avatar-sarah.webp" alt="Sarah Kim" /></span>
              <div><small>Sarah Kim</small><p>Let me check the deployment logs.</p><time>10:31</time></div>
            </div>
          </div>
          <div class="hi-composer-wrap">
            <div class="hi-composer">
              <div class="hi-composer-field">Write a message...</div>
              <div class="hi-composer-tools">
                <span>
                  <button aria-label="Emoji"><svg class="hi-icon"><use href="#hi-smile"></use></svg></button>
                  <button aria-label="Attach"><svg class="hi-icon"><use href="#hi-paperclip"></use></svg></button>
                  <button aria-label="Image"><svg class="hi-icon"><use href="#hi-image"></use></svg></button>
                  <button aria-label="Voice"><svg class="hi-icon"><use href="#hi-mic"></use></svg></button>
                </span>
                <button class="hi-send" aria-label="Send"><svg class="hi-icon"><use href="#hi-send"></use></svg></button>
              </div>
            </div>
          </div>
        </section>
      </div>
    </div>

    <div class="hi-phone">
      <div class="hi-phone-status"><span>9:41</span><span>5G&nbsp; 100%</span></div>
      <div class="hi-phone-app">
        <header>
          <span><svg class="hi-icon"><use href="#hi-arrow-left"></use></svg></span>
          <span class="hi-avatar hi-avatar--mobile hi-avatar--group"><img src="/avatar-alice.webp" alt="" /><img src="/avatar-emma.webp" alt="" /></span>
          <div><strong>Dev Team</strong><small><svg class="hi-icon hi-icon--tiny"><use href="#hi-lock"></use></svg> End-to-end encrypted</small></div>
          <span><svg class="hi-icon"><use href="#hi-more"></use></svg></span>
        </header>
        <nav><b>Chat</b><span>Pinned</span></nav>
        <div class="hi-mobile-pinned">PINNED · Bring the prototype demo?</div>
        <div class="hi-mobile-stream">
          <div class="hi-mobile-message">
            <span class="hi-avatar hi-avatar--small"><img src="/avatar-emma.webp" alt="" /></span>
            <p>The new build is ready for testing.</p>
          </div>
          <div class="hi-mobile-message mine"><p>I found a memory leak. Looking into it.</p></div>
          <div class="hi-mobile-message">
            <span class="hi-avatar hi-avatar--small"><img src="/avatar-sarah.webp" alt="" /></span>
            <p>Let me check the deployment logs.</p>
          </div>
        </div>
        <footer>
          <button aria-label="Attach"><svg class="hi-icon"><use href="#hi-plus"></use></svg></button>
          <button aria-label="Voice"><svg class="hi-icon"><use href="#hi-mic"></use></svg></button>
          <span>Message</span>
          <button class="hi-mobile-send" aria-label="Send"><svg class="hi-icon"><use href="#hi-send"></use></svg></button>
        </footer>
      </div>
    </div>
  </div>
</section>

<section class="hi-chapter hi-chapter--dark">
  <div class="pt-shell">
    <header class="hi-chapter-head">
      <div><p class="hi-index">{ui.ownershipIndex}</p><h2>{ui.ownershipTitle}</h2></div>
      <p>{ui.ownershipBody}</p>
    </header>
    <p class="hi-source hi-source--dark"><span></span>{ui.stationSignal}</p>

    <div class="hi-station-window">
      <aside>
        <div class="hi-station-brand"><img src="/peers-icon.png" alt="" /><div><strong>Station</strong><span>Dashboard</span></div></div>
        <button class="active"><b>▦</b><span>Overview</span></button>
        <button><b>◉</b><span>Transport</span></button>
        <button><b>◎</b><span>Actors</span></button>
        <button><b>□</b><span>Sessions</span></button>
        <button><b>⌁</b><span>Nodes</span></button>
        <button><b>▤</b><span>Services</span></button>
        <button><b>▥</b><span>Storage</span></button>
        <button><b>▣</b><span>Security</span></button>
        <footer>peers-station-prod-01<br />v1.4.2 · uptime 14d</footer>
      </aside>
      <div class="hi-station-main">
        <header><span>▦</span><div><h3>Overview</h3><p>Station operational summary and recent activity</p></div></header>
        <div class="hi-stats">
          <article><span>Total Actors</span><strong>2,847</strong><small>+12 today</small></article>
          <article><span>Active Actors</span><strong>1,203</strong><small>+5.2%</small></article>
          <article><span>Peer Stations</span><strong>18</strong><small>+2 this week</small></article>
        </div>
        <div class="hi-station-grid">
          <article>
            <h4>Recent Actors</h4>
            <table>
              <thead><tr><th>PTID</th><th>Name</th><th>Status</th></tr></thead>
              <tbody>
                <tr><td>pt:actor:a8f2</td><td>Alice Chen</td><td><b>active</b></td></tr>
                <tr><td>pt:actor:b3e7</td><td>Bob Martinez</td><td><b>active</b></td></tr>
                <tr><td>pt:actor:d4a6</td><td>David Kumar</td><td><b class="pending">pending</b></td></tr>
              </tbody>
            </table>
          </article>
          <article>
            <h4>Federation Health</h4>
            <div class="hi-health-row"><span>Alpha Research Network</span><b>healthy</b></div>
            <div class="hi-health-row"><span>Open Social Commons</span><b>healthy</b></div>
            <div class="hi-health-row"><span>Dev & Testing Ring</span><b class="pending">degraded</b></div>
          </article>
        </div>
      </div>
    </div>

    <div class="hi-principles">
      {p.layers.items.map((item) => (
        <article><span>{item.tag}</span><h3>{item.name}</h3><p>{item.body}</p></article>
      ))}
    </div>
  </div>
</section>

<section class="hi-chapter">
  <div class="pt-shell">
    <header class="hi-chapter-head">
      <div><p class="hi-index">{ui.networkIndex}</p><h2>{ui.networkTitle}</h2></div>
      <p>{ui.networkBody}</p>
    </header>
    <p class="hi-source"><span></span>{ui.networkSignal}</p>

    <div class="hi-network-layout">
      <div class="hi-contacts-window">
        <aside class="hi-contact-list">
          <header>Contacts <button aria-label="Add contact"><svg class="hi-icon hi-icon--small"><use href="#hi-plus"></use></svg></button></header>
          <div class="hi-contact-search"><svg class="hi-icon hi-icon--small"><use href="#hi-search"></use></svg> Find people</div>
          <article class="active"><span class="hi-avatar"><img src="/avatar-sarah.webp" alt="Bob" /></span><div><strong>Bob</strong><span>@bob@aspen.social</span><small>Friends Federation</small></div></article>
          <article><span class="hi-avatar"><img src="/avatar-emma.webp" alt="Carol" /></span><div><strong>Carol</strong><span>@carol@harbor.social</span><small>Open Social Commons</small></div></article>
          <article><span class="hi-avatar"><img src="/avatar-alice.webp" alt="Alice" /></span><div><strong>Alice</strong><span>@alice@north.social</span><small>Alpha Network</small></div></article>
        </aside>
        <section class="hi-identity">
          <span class="hi-avatar hi-avatar--profile"><img src="/avatar-sarah.webp" alt="Bob" /></span>
          <h3>Bob</h3>
          <p>@bob@aspen.social</p>
          <dl>
            <div><dt>Federation</dt><dd>Friends Federation</dd></div>
            <div><dt>Home Station</dt><dd>aspen.social</dd></div>
            <div><dt>Station Peer ID</dt><dd>12D3KooW-aspen</dd></div>
          </dl>
          <button><svg class="hi-icon hi-icon--small"><use href="#hi-message"></use></svg> Message</button>
        </section>
      </div>

      <div class="hi-network-phone">
        <div class="hi-phone-status"><span>9:41</span><span>5G&nbsp; 100%</span></div>
        <div class="hi-phone-app">
          <header>
            <span><svg class="hi-icon"><use href="#hi-arrow-left"></use></svg></span>
            <span class="hi-avatar hi-avatar--mobile"><img src="/avatar-sarah.webp" alt="Bob" /></span>
            <div><strong>Bob</strong><small><svg class="hi-icon hi-icon--tiny"><use href="#hi-lock"></use></svg> End-to-end encrypted</small></div>
            <span><svg class="hi-icon"><use href="#hi-more"></use></svg></span>
          </header>
          <nav><b>Chat</b><span>Pinned</span></nav>
          <div class="hi-mobile-stream">
            <div class="hi-mobile-message"><span class="hi-avatar hi-avatar--small"><img src="/avatar-sarah.webp" alt="" /></span><p>Saturday hike? I sent the route from Aspen Station.</p></div>
            <div class="hi-mobile-message mine"><p>I’m in. Send me the meeting point.</p></div>
            <div class="hi-mobile-message"><span class="hi-avatar hi-avatar--small"><img src="/avatar-sarah.webp" alt="" /></span><p>Sent. Cross-Station delivery confirmed.</p></div>
          </div>
          <footer><button><svg class="hi-icon"><use href="#hi-plus"></use></svg></button><button><svg class="hi-icon"><use href="#hi-mic"></use></svg></button><span>Message</span><button class="hi-mobile-send"><svg class="hi-icon"><use href="#hi-send"></use></svg></button></footer>
        </div>
      </div>
    </div>

    <div class="hi-point-list">
      {p.network.points.map((point, index) => (
        <article><span>0{index + 1}</span><div><h3>{point.title}</h3><p>{point.body}</p></div></article>
      ))}
    </div>
  </div>
</section>

<section class="hi-chapter hi-chapter--agent">
  <div class="pt-shell">
    <header class="hi-chapter-head">
      <div><p class="hi-index">{ui.agentIndex}</p><h2>{ui.agentTitle}</h2></div>
      <p>{ui.agentBody}</p>
    </header>
    <p class="hi-source"><span></span>{ui.agentSignal}</p>

    <div class="hi-agent-window">
      <aside class="hi-global-rail">
        <span class="hi-avatar hi-avatar--self"><img src="/avatar-alice.webp" alt="Alex Chen" /></span>
        <button aria-label="Search"><svg class="hi-icon"><use href="#hi-search"></use></svg></button>
        <span class="hi-rail-divider"></span>
        <button aria-label="Chat"><svg class="hi-icon"><use href="#hi-message"></use></svg></button>
        <button class="active" aria-label="Agent"><svg class="hi-icon"><use href="#hi-bot"></use></svg></button>
        <span class="hi-rail-spacer"></span>
        <button aria-label="Settings"><svg class="hi-icon"><use href="#hi-settings"></use></svg></button>
      </aside>
      <div class="hi-agent-product">
        <nav><b>Agent</b><span>Atelier</span><span>Orchestration</span></nav>
        <div class="hi-agent-layout">
          <aside class="hi-agent-list">
            <header>My Agents <button><svg class="hi-icon hi-icon--small"><use href="#hi-plus"></use></svg></button></header>
            <div class="hi-agent-search"><svg class="hi-icon hi-icon--small"><use href="#hi-search"></use></svg> Search agents</div>
            <small>PINNED</small>
            <article class="active"><i>T</i><div><strong>Travel Assistant</strong><span>Travel planning assistant</span></div></article>
            <small>ALL AGENTS</small>
            <article><i>A</i><div><strong>AI UI Automation</strong><span>Workspace automation</span></div></article>
            <article><i>M</i><div><strong>MCP-Tester</strong><span>Capability testing</span></div></article>
          </aside>
          <section class="hi-agent-chat">
            <header><div><i>T</i><span><strong>Travel Assistant</strong><small>GPT-5.5 · Station ready</small></span></div><b>Station authoritative</b></header>
            <div class="hi-agent-thread">
              <article class="user"><small>You</small><p>{locale === 'zh' ? '把周六徒步路线整理成日历事件，写入前先让我确认。' : 'Turn Saturday’s hike into a calendar event. Ask before saving it.'}</p></article>
              <article><small>Travel Assistant · Agent</small><p>{locale === 'zh' ? '已整理为一条日历事件。以下内容等待你的确认：' : 'I prepared one calendar event and left it waiting for your confirmation.'}</p>
