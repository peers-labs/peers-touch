---
/**
 * LayerStack — the Client → Model → Station architecture.
 *
 * Rendered as HTML (not a fixed SVG) so the responsibility text stays crisp and
 * reflows on every screen. Bidirectional connectors between bands communicate
 * the contract flow: clients never reach past the model into storage.
 */
interface LayerItem {
  name: string;
  tag: string;
  body: string;
}

interface Props {
  items: LayerItem[];
}

const { items } = Astro.props;
---

<div class="layers">
  {
    items.map((item, i) => (
      <>
        <article class={`layer layer--${i}`}>
          <span class="layer__icon" aria-hidden="true">
            {i === 0 && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2.5" y="4" width="13.5" height="10" rx="1.6" />
                <path d="M8.2 18h2.1M9.25 14v4" />
                <rect x="17.5" y="9" width="4" height="11" rx="1.4" />
              </svg>
            )}
            {i === 1 && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d="M8 4c-2.2 0-3.5 1.6-3.5 4s1.3 4 3.5 4" />
                <path d="M16 12c2.2 0 3.5-1.6 3.5-4S18.2 4 16 4" />
                <path d="M9 4v16M15 4v16" />
              </svg>
            )}
            {i === 2 && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <ellipse cx="12" cy="5.5" rx="8" ry="3" />
                <path d="M4 5.5v13c0 1.66 3.58 3 8 3s8-1.34 8-3v-13" />
                <path d="M4 12c0 1.66 3.58 3 8 3s8-1.34 8-3" />
              </svg>
            )}
          </span>
          <div class="layer__body">
            <div class="layer__head">
              <h3 class="layer__name">{item.name}</h3>
              <span class="layer__tag">{item.tag}</span>
            </div>
            <p class="layer__desc">{item.body}</p>
          </div>
        </article>
        {i < items.length - 1 && (
          <span class="connector" aria-hidden="true">
            <svg viewBox="0 0 24 28" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3v22" />
              <path d="M7 7.5L12 2.5l5 5" />
              <path d="M7 20.5l5 5 5-5" />
            </svg>
          </span>
        )}
      </>
    ))
  }
</div>

<style>
  .layers {
    display: flex;
    flex-direction: column;
  }
  .layer {
    display: flex;
    gap: var(--pt-space-m);
    align-items: flex-start;
    padding: var(--pt-space-l) var(--pt-space-l);
    background: var(--pt-surface-card);
    border: 1px solid var(--pt-border-hairline);
    border-radius: var(--pt-radius-lg);
    box-shadow: var(--pt-shadow-soft);
  }
  .layer--0 {
    border-left: 3px solid #667eea;
  }
  .layer--1 {
    border-left: 3px solid #7d8fef;
  }
  .layer--2 {
    border-left: 3px solid #765aa2;
  }
  .layer__icon {
    flex: none;
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    border-radius: var(--pt-radius-md);
    background: var(--pt-surface-subtle);
    color: var(--pt-accent-strong);
  }
  .layer--2 .layer__icon {
    color: var(--pt-relay);
  }
  .layer__icon svg {
    width: 24px;
    height: 24px;
  }
  .layer__head {
    display: flex;
    align-items: center;
    gap: var(--pt-space-s);
    flex-wrap: wrap;
  }
  .layer__name {
    margin: 0;
    font-size: 18px;
    font-weight: 700;
    color: var(--pt-text-primary);
  }
  .layer__tag {
    font-size: 11.5px;
    font-weight: 600;
    color: var(--pt-accent-strong);
    background: var(--pt-surface-subtle);
    border: 1px solid var(--pt-border-hairline);
    padding: 2px 10px;
    border-radius: var(--pt-radius-full);
  }
  .layer--2 .layer__tag {
    color: var(--pt-relay);
  }
  .layer__desc {
    margin: 6px 0 0;
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--pt-text-secondary);
  }
  .connector {
    align-self: center;
    width: 22px;
    height: 26px;
    color: #aab4e4;
    margin: 2px 0;
  }
  @media (max-width: 620px) {
    .layer {
      padding: var(--pt-space-m);
      gap: var(--pt-space-s);
    }
    .layer__icon {
      width: 40px;
      height: 40px;
    }
  }
</style>
