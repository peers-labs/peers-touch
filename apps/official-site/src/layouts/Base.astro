---
import '../styles/tokens.css';
import { getDict, localePath, switchLocalePath, LOCALES, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  page: 'home' | 'product' | 'roadmap' | 'community';
  currentPath: string;
}

const { locale, page, currentPath } = Astro.props;
const t = getDict(locale);

const GITHUB_URL = 'https://github.com/peers-labs/peers-touch';

const navItems = [
  { key: 'home', href: localePath(locale), label: t.nav.home },
  { key: 'product', href: localePath(locale, 'product'), label: t.nav.product },
  { key: 'roadmap', href: localePath(locale, 'roadmap'), label: t.nav.roadmap },
  { key: 'community', href: localePath(locale, 'community'), label: t.nav.community },
] as const;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.siteName} — {t.meta.tagline}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/logo.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {LOCALES.map((l) => (
      <link rel="alternate" hreflang={l} href={switchLocalePath(currentPath, l)} />
    ))}
  </head>
  <body>
    <a class="pt-skip" href="#main">Skip to content</a>
    <header class="pt-header">
      <div class="pt-shell pt-header__inner">
        <a class="pt-brand" href={localePath(locale)} aria-label={t.meta.siteName}>
          <img class="pt-brand__logo" src="/peers-icon.png" alt="Peers" />
        </a>
        <nav class="pt-nav" aria-label="Primary">
          {navItems.map((item) => (
            <a
              class={`pt-nav__link${page === item.key ? ' pt-nav__link--active' : ''}`}
              href={item.href}
              aria-current={page === item.key ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>
        <div class="pt-header__actions">
          <div class="pt-lang" role="group" aria-label={t.langSwitch.label}>
            {LOCALES.map((l) => (
              <a
                class={`pt-lang__opt${l === locale ? ' pt-lang__opt--active' : ''}`}
                href={switchLocalePath(currentPath, l)}
                hreflang={l}
              >
                {l === 'en' ? t.langSwitch.en : t.langSwitch.zh}
              </a>
            ))}
          </div>
          <a class="pt-btn pt-btn--ghost pt-header__gh" href={GITHUB_URL} rel="noopener">
            {t.nav.github}
          </a>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="pt-footer">
      <div class="pt-shell pt-footer__inner">
        <div class="pt-footer__brand">
          <img src="/peers-icon.png" alt="Peers" style="height: 24px; width: 24px; border-radius: 5px;" />
          <span>{t.footer.rights}</span>
        </div>
        <div class="pt-footer__meta">
          <a href={GITHUB_URL} rel="noopener">GitHub</a>
          <span>© {new Date().getFullYear()} {t.footer.rights}</span>
        </div>
      </div>
    </footer>

    <style>
      .pt-skip {
        position: absolute;
        left: -999px;
        top: 0;
        background: var(--pt-accent);
        color: var(--pt-text-on-accent);
        padding: 8px 16px;
        border-radius: 0 0 var(--pt-radius-md) 0;
        z-index: 100;
      }
      .pt-skip:focus {
        left: 0;
      }

      .pt-header {
        position: sticky;
        top: 0;
        z-index: 40;
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        background: rgba(251, 252, 255, 0.72);
        border-bottom: 1px solid var(--pt-border-hairline);
      }
      .pt-header__inner {
        display: flex;
        align-items: center;
        gap: var(--pt-space-lg);
        height: 68px;
      }
      .pt-brand {
        display: inline-flex;
        align-items: center;
      }
      .pt-brand__logo {
        height: 44px;
        width: 44px;
        border-radius: 10px;
      }
      .pt-nav {
        display: flex;
        gap: var(--pt-space-md);
        margin-right: auto;
      }
      .pt-nav__link {
        font-size: 15px;
        color: var(--pt-text-secondary);
        padding: 6px 2px;
        border-bottom: 2px solid transparent;
        transition: color var(--pt-motion-fast) var(--pt-ease);
      }
      .pt-nav__link:hover {
        color: var(--pt-text-primary);
      }
      .pt-nav__link--active {
        color: var(--pt-text-primary);
        border-bottom-color: var(--pt-accent);
      }
      .pt-header__actions {
        display: flex;
        align-items: center;
        gap: var(--pt-space-sm);
      }
      .pt-lang {
        display: inline-flex;
        padding: 3px;
        border-radius: var(--pt-radius-full);
        background: var(--pt-surface-subtle);
        border: 1px solid var(--pt-border-hairline);
      }
      .pt-lang__opt {
        font-size: 13px;
        font-weight: 600;
        padding: 4px 12px;
        border-radius: var(--pt-radius-full);
        color: var(--pt-text-secondary);
        transition: all var(--pt-motion-fast) var(--pt-ease);
      }
      .pt-lang__opt--active {
        background: var(--pt-surface-base);
        color: var(--pt-accent);
        box-shadow: var(--pt-shadow-soft);
      }

      .pt-footer {
        margin-top: var(--pt-space-2xl);
        border-top: 1px solid var(--pt-border-hairline);
        padding-block: var(--pt-space-lg);
      }
      .pt-footer__inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--pt-space-md);
        flex-wrap: wrap;
        color: var(--pt-text-secondary);
        font-size: 14px;
      }
      .pt-footer__brand {
        display: inline-flex;
        align-items: center;
        gap: var(--pt-space-xs);
        font-weight: 500;
        color: var(--pt-text-primary);
      }
      .pt-footer__meta {
        display: inline-flex;
        align-items: center;
        gap: var(--pt-space-md);
      }
      .pt-footer__meta a:hover {
        color: var(--pt-accent);
      }

      @media (max-width: 720px) {
        .pt-nav {
          display: none;
        }
        .pt-header__gh {
          display: none;
        }
      }
    </style>
  </body>
</html>
