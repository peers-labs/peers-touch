  "cards": [
    {
      "dot": "cyan",
      "title": "Commit boundary",
      "items": [
        "Business mutation, Inbox/Outbox and required event facts commit in the owning transaction.",
        "SSE or realtime notification is a post-commit wake hint, never the durable truth."
      ]
    },
    {
      "dot": "rose",
      "title": "Hard dependency rule",
      "items": [
        "Frame/Touch owns ingress, Session and transport without importing App business semantics."
