  "cards": [
    {
      "dot": "cyan",
      "title": "One action, one message",
      "items": [
        "Double click, ambiguous IPC answer or failure-driven retry with the same intent resolves to the same message and attachment batch.",
        "A deferred draft is an admitted success; worker wake uncertainty no longer reports send failure."
      ]
    },
    {
      "dot": "emerald",
      "title": "Facts beat judgment",
      "items": [
        "Queued, submitted, delivered, fully delivered, read and terminal failure come from durable truth.",
        "60s/24h horizons are projection-only local judgments: a later receipt always upgrades them."
      ]
    },
    {
      "dot": "rose",
      "title": "No negative proof",
      "items": [
        "An unreachable peer Station can recover hours later, so the network cannot prove non-delivery; exact-bytes retry continues."
      ]
    }
  ]
