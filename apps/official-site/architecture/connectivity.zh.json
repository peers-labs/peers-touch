  "cards": [
    {
      "dot": "cyan",
      "title": "路径切换合同",
      "items": [
        "Direct 与 Circuit 汇合到同一 Station Identity 与 Canonical Ingress。",
        "自动 Replay 仅允许 SafeRead 或显式 Idempotent Request。"
      ]
    },
    {
      "dot": "rose",
      "title": "Generation Fence",
      "items": [
        "Route 替换会使旧 RouteLease、Grant 与 Private Permit 失效。",
        "Relay 拥有有界 Admission 与不透明字节，不拥有 Session 或业务路由。"
      ]
    }
