  "cards": [
    {
      "dot": "cyan",
      "title": "SFU, not a P2P mesh",
      "items": [
        "Each client uploads once to LiveKit; the SFU distributes to room members, avoiding N×N links.",
        "1:1 calls use P2P with TURN fallback; group calls use the SFU — two independent media paths."
      ]
    },
    {
      "dot": "rose",
      "title": "External dependency and degradation",
      "items": [
        "LiveKit is deployed separately via LIVEKIT_API_URL / PUBLIC_URL / KEY / SECRET; when unconfigured, join is rejected while 1:1 calls and messaging keep working.",
        "LiveKit's built-in TURN is disabled; media uses ports 7880/7881 and the configured external IP."
      ]
    }
  ]
