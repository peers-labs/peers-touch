  "cards": [
    {
      "dot": "cyan",
      "title": "启动期用途（离线引导）",
      "items": [
        "L0/L1/L2 编译进包：无网络也具备身份、信任根与目录 origins。",
        "L3 在任何拉取前以 embedded 新鲜度先可见；一旦存在 current 快照，它不再参与指令求值。",
        "L4 仅在 Station 注册表为空时触发一次现场发现；Station 信任在现场建立，绝不来自烧录。"
      ]
    },
    {
      "dot": "violet",
      "title": "远程分发用途（运行时权威）",
      "items": [
        "后台按 L2 合并源（override、广告源、烘焙尾锚）拉取签名信封。",
        "接受的 current 快照取代 L3；过期 embedded 变 stale，不再可操作。",
        "目录刷新永不改写 L5：注册表、会话、当前 Station 与 Actor 作用域归设备所有。"
      ]
    }
  ]
