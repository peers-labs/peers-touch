	@echo "  make plan-validate PLAN=<path> Validate a frozen Plan Version"
	@echo "  make plan-inspect PLAN=<path>  Inspect Plan structure without machine state"
	@echo "  make plan-task PLAN=<path> TASK=<id>  Read one Plan task"
	@echo "  make completion-review-prepare OBLIGATIONS='<json>' [EVIDENCE='<json>']"
