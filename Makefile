	@echo "  make profiles                  List approved and unapproved profile observations"
	@echo "  make config                    Show active profile config"
	@echo "  make dev-start TASK=x ...      Optionally create task-local recovery state"
	@echo "  make dev-update TASK=x ...     Update task-local state with revision/CAS"
	@echo "  make dev-status TASK=x         Show one explicitly selected task"
	@echo "  make dev-status-all            Show task-local records in this worktree"
	@echo "  make dev-close TASK=x ...      Close only the selected task record"
	@echo "  make plan-validate PLAN=<path> Validate an explicit frozen Plan Version"
	@echo "  make plan-inspect PLAN=<path>  Inspect an explicit Plan without mounting it"
	@echo "  make plan-task PLAN=<path> TASK=<id>  Read one explicit Plan task"
	@echo ""
	@echo "  make station                   Ready Station (local start / remote deploy)"
	@echo "  make station-check             Health-check Station only"
	@echo "  make station-status            Show Station deployment/runtime status"
	@echo "  make station-logs              Show Station logs"
	@echo "  make relay                     Ready Relay (remote deploy)"
	@echo "  make relay-check               Health-check Relay only"
