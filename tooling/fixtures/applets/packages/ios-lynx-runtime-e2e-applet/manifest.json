      "entry": "main.lynx.bundle"
    }
  },
  "bridge": {
    "protocol": "peers-touch.applet.bridge",
    "version": "1.0.0"
  },
  "permissions": [
    "storage.set",
    "storage.get"
  ],
  "services": [],
  "skills": [],
