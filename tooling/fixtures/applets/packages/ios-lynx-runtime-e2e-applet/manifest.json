{
  "id": "ios-lynx-runtime-e2e-applet",
  "name": "iOS Lynx Runtime E2E Applet",
  "version": "1.0.0",
  "description": "Minimal SDK applet used by simulator runtime E2E to prove iOS Lynx bridge execution.",
  "author": "Peers Touch",
  "targets": [
    "ios"
  ],
