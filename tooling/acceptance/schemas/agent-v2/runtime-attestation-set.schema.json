{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://peers.touch/schemas/agent-v2/runtime-attestation-set.schema.json",
  "title": "Agent V2 Runtime Attestation Set",
  "type": "object",
  "required": ["artifactKind", "schema", "role", "gateId", "runId", "sourceIdentity", "runtimeMatrix", "tuples", "oracle", "observedAt"],
  "properties": {
    "artifactKind": {"const": "agent-v2-runtime-attestation-set"},
    "schema": {"type": "object"},
    "role": {"const": "runtime-attestation-set"},
    "gateId": {"type": "string", "minLength": 1},
    "runId": {"type": "string", "minLength": 1},
    "sourceIdentity": {"type": "object"},
    "runtimeMatrix": {"type": "object"},
    "tuples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "gate", "row", "platform", "runtime", "cell", "locale", "ordering", "sample_id",
          "actorIdentityHash", "conversationRuntimeBinding", "runtimeSnapshot",
          "turnAttempt", "toolCallBinding", "clientSession", "stationProfile",
          "desktopMode", "networkPath", "machine", "coldWarmState", "observedAt"
        ],
        "properties": {
          "actorIdentityHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "conversationRuntimeBinding": {
            "type": "object",
            "required": [
              "runtimeKind", "providerId", "modelId", "runtimeProfileId",
              "externalSessionId", "externalSessionEpoch", "runtimeHomeRefHash",
              "capabilitySnapshotHash", "configSnapshotHash", "boundAt"
            ]
          },
          "runtimeSnapshot": {
            "type": "object",
            "required": [
              "runtimeKind", "providerId", "modelId", "runtimeProfileId",
              "capabilities", "providerConfigVersion", "agentConfigVersion",
              "externalSessionId", "externalSessionEpoch"
            ],
            "properties": {
              "capabilities": {
                "type": "object",
                "required": [
                  "input", "output", "runtime", "agentic", "limits",
                  "resolution", "provenance"
                ]
              }
            }
          },
          "turnAttempt": {
            "type": "object",
            "required": [
              "attemptId", "turnId", "index", "contextLedgerId",
              "capabilityReadinessSnapshotId", "status",
              "runtimeSnapshotHash"
            ]
          },
          "toolCallBinding": {
            "type": "object",
            "required": [
              "toolCallId", "turnId", "attemptId",
              "capabilityId", "capabilityVersion", "bindingId",
              "bindingRevision", "readinessSnapshotId",
              "selectedDeviceId", "selectedLeaseId",
              "sideEffectReceiptId"
            ]
          },
          "clientSession": {
            "type": "object",
            "required": [
              "capabilitySessionId", "actorIdHash", "deviceId",
              "platform", "capabilities", "expiresAt",
              "connectionId", "leaseId"
            ],
            "properties": {
              "capabilities": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "capabilityId", "schemaVersion", "permission",
                    "constraints"
                  ],
                  "properties": {
                    "constraints": {
                      "type": "object",
                      "required": [
                        "maxRequestBytes", "maxResultBytes",
                        "allowedResourceKinds"
                      ]
                    }
                  }
                }
              }
            }
          },
          "stationProfile": {"type": "string", "minLength": 1},
          "desktopMode": {"type": "string", "minLength": 1},
          "networkPath": {"type": "string", "minLength": 1},
          "machine": {"type": "string", "minLength": 1},
          "coldWarmState": {"enum": ["cold", "warm", "neutral", "contract"]},
          "observedAt": {"type": "string", "minLength": 1}
        }
      }
    },
    "oracle": {
      "type": "object",
      "required": ["assertionId", "status", "expectedTupleCount"],
      "properties": {
        "assertionId": {"type": "string", "minLength": 1},
        "status": {"const": "passed"},
        "expectedTupleCount": {"type": "integer", "minimum": 1}
      }
    },
    "observedAt": {"type": "string", "minLength": 1}
  }
}
