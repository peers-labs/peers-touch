{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://peers.touch/schemas/agent-v2/proof-envelope.schema.json",
  "title": "Agent V2 Proof Envelope",
  "type": "object",
  "required": ["artifactKind", "schemaVersion", "proofStatus", "gateId", "candidateManifest", "runnerAttestation", "validatorRun", "validatorAttestation", "sourceIdentity", "runtimeMatrix", "roleSchemas"],
  "properties": {
    "artifactKind": {"const": "agent-v2-proof-envelope"},
    "schemaVersion": {"const": 1},
    "proofStatus": {"const": "PROVEN"},
    "gateId": {"type": "string", "minLength": 1},
    "candidateManifest": {"type": "object"},
    "runnerAttestation": {"type": "object"},
    "validatorRun": {"type": "object"},
    "validatorAttestation": {"type": "object"},
    "sourceIdentity": {"type": "object"},
    "runtimeMatrix": {"type": "object"},
    "roleSchemas": {"type": "object", "minProperties": 1}
  }
}
