  },
  "evidenceRequired": [
    "screenshot",
    "dom",
    "accessibility",
    "interactionTrace"
  ],
  "viewportTextSizeCells": [
    "portrait-normal",
    "portrait-maximum-text",
    "landscape-normal"
  ],
  "expectedResultTemplates": {
    "launch-state": "{routeOrState} presents one understandable state and one valid next action",
    "composite-control": "{routeOrState} behaves as one coherent field with visible focus, status, error, and recovery",
    "primary-route": "{routeOrState} presents the correct page identity, primary content, and navigation context",
    "primary-state": "{routeOrState} remains distinct from loading and unavailable states and exposes a valid next action",
    "recovery": "{routeOrState} remains scoped to its owner, explains impact, and preserves unrelated usable content",
    "detail-route": "{routeOrState} preserves parent context, friendly identity, readable content, and a working back action",
    "detail-state": "{routeOrState} preserves the active detail and exposes a clear state-specific action",
    "input-state": "{routeOrState} keeps the active input and primary content visible above keyboard and safe-area layers",
    "overlay": "{routeOrState} exposes complete actions without hiding the selected content or losing dismissal",
    "overlay-route": "{routeOrState} presents one bounded task with accessible controls, feedback, and dismissal",
    "overlay-state": "{routeOrState} preserves entered work and exposes state-specific recovery"
  },
  "qualityRules": {
    "minimumTouchTargetCssPx": 44,
    "forbiddenVisibleTextPatterns": [
      "^ptid:v[0-9]+:",
      "^(mobile|common|chat)\\.[A-Za-z0-9_.-]+$"
    ],
    "forbiddenBlockingSelectors": [
      "[data-acceptance-id=\"recovery-deferred-capability\"][data-blocks-unrelated-content=\"true\"]"
    ],
    "requirePrimaryHeading": true,
    "requirePrimaryActionOrReadableTerminalState": true,
    "requireViewportContainment": true,
    "requireNonOcclusion": true
  },
