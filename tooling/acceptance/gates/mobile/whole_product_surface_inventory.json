    "entry": "mobile-simulator-whole-product-usability-e2e",
    "shell": "mobile-simulator-whole-product-usability-e2e",
    "recovery": "mobile-simulator-whole-product-usability-e2e",
    "chat": "mobile-simulator-whole-product-usability-e2e",
    "contacts": "mobile-simulator-whole-product-usability-e2e",
    "moments": "mobile-simulator-whole-product-usability-e2e",
    "settings": "mobile-simulator-whole-product-usability-e2e",
