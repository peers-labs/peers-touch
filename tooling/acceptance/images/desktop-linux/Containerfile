ARG BASE_IMAGE=ubuntu@sha256:33ceb71981b602c1a7443a53469e4dba065f7503eab3078a2d7a57a2ab987517
FROM ${BASE_IMAGE}

ARG NODE_VERSION=24.10.0
ARG NODE_SHA256=2642f4428869aca32443660fd71b3918e2be1277a899bdcaeb64c93b54b5af17
ARG NODE_DIST_URL=https://nodejs.org/dist
ARG PNPM_VERSION=9.12.0
ARG RUST_TOOLCHAIN=1.94.0
ARG RUSTUP_INIT_SHA256=20a06e644b0d9bd2fbdbfd52d42540bdde820ea7df86e92e533c073da0cdd43c
ARG RUSTUP_DIST_SERVER=https://static.rust-lang.org
ARG RUSTUP_UPDATE_ROOT=https://static.rust-lang.org/rustup
ARG USER_ID=1000
ARG USER_GROUP_ID=1000

ENV DEBIAN_FRONTEND=noninteractive
ENV CARGO_HOME=/opt/cargo
ENV COREPACK_HOME=/opt/corepack
ENV RUSTUP_HOME=/opt/rustup
ENV PATH=/opt/cargo/bin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        at-spi2-core \
        build-essential \
        ca-certificates \
        curl \
        dbus-x11 \
        file \
        fonts-dejavu-core \
        git \
        gnome-keyring \
        iproute2 \
        jq \
        libayatana-appindicator3-dev \
        libdbus-1-dev \
        libgtk-3-dev \
        librsvg2-dev \
        libsecret-1-0 \
        libsecret-tools \
        libssl-dev \
        libprotobuf-dev \
        libwebkit2gtk-4.1-dev \
        libxdo-dev \
        lsof \
        netcat-openbsd \
        openbox \
        openssh-client \
        pkg-config \
        procps \
        protobuf-compiler \
        python3 \
        python3-pip \
        python3-pyatspi \
        python3-venv \
        python3-xlib \
        scrot \
        tini \
        wget \
        wmctrl \
        x11-utils \
        x11-xserver-utils \
        x11vnc \
        xclip \
        xdotool \
        xserver-xorg-core \
        xserver-xorg-video-dummy \
        zenity \
    && rm -rf /var/lib/apt/lists/*

RUN set -eu; \
    archive="node-v${NODE_VERSION}-linux-x64.tar.xz"; \
    curl --retry 3 --connect-timeout 10 --max-time 180 -fsSLO \
      "${NODE_DIST_URL}/v${NODE_VERSION}/${archive}"; \
    printf '%s  %s\n' "${NODE_SHA256}" "${archive}" | sha256sum -c -; \
    tar -xJf "${archive}" -C /usr/local --strip-components=1; \
    rm "${archive}"; \
    corepack enable; \
    corepack prepare "pnpm@${PNPM_VERSION}" --activate; \
    chmod -R a+rX "${COREPACK_HOME}"

RUN set -eu; \
    export RUSTUP_DIST_SERVER RUSTUP_UPDATE_ROOT; \
    curl --retry 3 --connect-timeout 10 --max-time 180 -fsSLo /tmp/rustup-init \
      "${RUSTUP_UPDATE_ROOT}/archive/1.28.2/x86_64-unknown-linux-gnu/rustup-init"; \
    printf '%s  %s\n' "${RUSTUP_INIT_SHA256}" /tmp/rustup-init | sha256sum -c -; \
    chmod 0755 /tmp/rustup-init; \
    /tmp/rustup-init -y --profile minimal --default-toolchain "${RUST_TOOLCHAIN}"; \
    rm /tmp/rustup-init; \
    chmod -R a+rX /opt/cargo /opt/rustup

RUN groupadd --gid "${USER_GROUP_ID}" ptacceptance \
    && useradd \
      --uid "${USER_ID}" \
      --gid "${USER_GROUP_ID}" \
      --create-home \
      --shell /bin/bash \
      ptacceptance

COPY xorg-dummy.conf /etc/X11/xorg-dummy.conf
COPY entrypoint.sh /usr/local/bin/peers-touch-linux-cell

RUN chmod 0755 /usr/local/bin/peers-touch-linux-cell \
    && pkg-config --exists webkit2gtk-4.1 \
    && node --version \
    && pnpm --version \
    && rustc --version \
    && cargo --version \
    && command -v zenity

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/peers-touch-linux-cell"]
