# Orange Pi Station template — one instance per branch
# Profile: station + infra
# Project: pt-orangepi-<branch>  (set by deploy-branch.sh)
#
# deploy-branch.sh generates a concrete .env from this template,
# substituting BRANCH, PORT, and relay bootstrap info at deploy time.

COMPOSE_PROJECT_NAME=pt-orangepi-__BRANCH__

# ── Required secrets ────────────────────────────────────────
PEERS_AUTH_SECRET=__GENERATE_WITH_openssl_rand_hex_32__
PEERS_DB_PASSWORD=__GENERATE_WITH_openssl_rand_hex_16__

# ── Postgres ──────────────────────────────────────────────────
POSTGRES_USER=peers
POSTGRES_DB=peers___BRANCH__

# ── Ports (host-side) ─────────────────────────────────────────
STATION_HOST=192.168.31.24
STATION_PORT=__PORT__
LIBP2P_PORT=__LIBP2P_PORT__

# ── Federation ────────────────────────────────────────────────
# Point to the local Relay as DHT seed.
PEERS_BOOTSTRAP_NODES=__RELAY_BOOTSTRAP_MULTIADDR__
PEERS_LIBP2P_PUBLIC_ADDRS=/ip4/192.168.31.24/tcp/__LIBP2P_PORT__
PEERS_FEDERATION_DIRECT_OUTBOUND=true
PEERS_FEDERATION_DIRECT_INBOUND=true

# ── Server baseurl (federation locator) ───────────────────────
PEERS_NODE_SERVER_BASEURL=http://192.168.31.24:__PORT__

# ── Relay-Client (mount onto local Relay) ─────────────────────
RELAY_CLIENT_ENABLED=true
RELAY_CLIENT_RELAY_URL=http://192.168.31.24:18081
RELAY_CLIENT_RELAY_STREAM_ADDR=192.168.31.24:4501
RELAY_CLIENT_INVITE_TOKEN=__ISSUE_VIA_pt-relay-issue-invites__
RELAY_CLIENT_LABEL=orangepi-__BRANCH__
