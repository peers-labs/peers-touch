# Docker deployment — dev-box (10.37.246.80)
# PG already running on host as `peers-pg` container.

# Required — JWT signing secret
PEERS_AUTH_SECRET=change-me-to-a-real-secret

# Use host network so station can reach PG on localhost
NETWORK_MODE=host

# Override PG DSN (matches existing peers-pg container on dev-box)
PEERS_DB_DSN=host=localhost user=peers password=peers_touch_2026 dbname=peers_touch port=5432 sslmode=disable TimeZone=Asia/Shanghai

# PostgreSQL (only used by `infra` profile — skip on dev-box, PG already running)
POSTGRES_USER=peers
POSTGRES_PASSWORD=peers_touch_2026
POSTGRES_DB=peers_touch

# Station
STATION_HOST=10.37.246.80
STATION_PORT=18080

# Relay Station
RELAY_STATION_PORT=18081
