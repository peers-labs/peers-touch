# Peers-Touch Docker env template — DO NOT put real secrets here.
#
# Per-environment files derived from this template are gitignored:
#   tooling/docker/.env                       (local Station-3, "pt-station-local")
#   tooling/docker/.env.pt-relay
#   tooling/docker/.env.pt-station-1
#   tooling/docker/.env.pt-station-2
#   tooling/docker/.env.pt-station-relay-only
#
# The Makefile selects the right file via REMOTE=<name>.

# ── Compose project namespace (Docker-layer isolation root) ──
# Always set this. compose prefixes container/network/volume names with it,
# so two test nodes on the same host never collide.
COMPOSE_PROJECT_NAME=pt-station-local

# ── Required secrets ────────────────────────────────────────
PEERS_AUTH_SECRET=                # openssl rand -hex 32
PEERS_DB_PASSWORD=                # PG password, shared across all 5 envs

# ── Postgres (per-project container, internal-only) ─────────
POSTGRES_USER=peers
POSTGRES_DB=peers_touch

# ── Station / Relay ports (host-side mapping) ───────────────
# STATION_HOST is read by `make dev-app REMOTE=<name>` so Desktop dev
# scripts can build PEERS_STATION_URL automatically.
STATION_HOST=127.0.0.1
STATION_PORT=18080
RELAY_STATION_PORT=18081

# libp2p port for the bootstrap subserver (host-side mapping).
# Same-host coexistence requires distinct values: 4001 for most, 4002 for
# pt-station-relay-only on 10.37.195.98 to avoid collision with pt-station-2.
LIBP2P_PORT=4001

# ── Node-level libp2p federation policy ─────────────────────
# All four vars project into peers.node.federation.* via
# federation.docker.yml (entrypoint.sh). Both libp2p hosts in the process
# (bootstrap subserver + transport) consume from this single namespace.

# Federation seeds. Comma-separated multiaddrs ending in /p2p/<peer-id>.
# Empty for pt-relay (it IS the seed). Filled in for stations by
# `make pt-discover-relay` after the Relay is up.
PEERS_BOOTSTRAP_NODES=

# Multiaddrs this node announces to the libp2p network. Required under
# Docker so DHT records carry the host IP, not the bridge IP. Set to the
# external host:port that maps to LIBP2P_PORT. Empty for relay-only nodes
# that should not be directly dialable.
PEERS_LIBP2P_PUBLIC_ADDRS=

# ConnectionGater switches. Both default to true (permissive). Set to
# false only on relay-only test nodes — the gater is installed on BOTH
# libp2p hosts (bootstrap subserver + transport) so the policy is total.
PEERS_FEDERATION_DIRECT_OUTBOUND=true
PEERS_FEDERATION_DIRECT_INBOUND=true

# ── Federation-visible HTTP origin ──────────────────────────
# Drives peers.node.server.baseurl. The locator publisher derives the
# federation StationDomain from the URL host portion of this value. Each
# station MUST set its own unique baseurl — federated handles minted on
# this station become @<user>@<host[:port]> derived from here.
PEERS_NODE_SERVER_BASEURL=

# ── Relay role security (required for relay profile) ─────────
# Provision these files outside Git and make them readable in the Relay
# container, for example below /app/data/relay/.
RELAY_STREAM_LISTEN_ADDR=:4501
RELAY_TLS_CERT_FILE=
RELAY_TLS_KEY_FILE=
RELAY_SIGNING_KEY_FILE=
RELAY_OPERATOR_KEY_FILE=
RELAY_OPERATOR_ISSUER=
RELAY_OPERATOR_AUDIENCE=
RELAY_OPERATOR_SCOPE=
# Development-only exception. The listener and public base URL must both be
# loopback when this is true; formal Acceptance must keep it false.
RELAY_ALLOW_INSECURE_LOOPBACK=false

# ── LiveKit SFU (group voice/video calls) ───────────────────
# LiveKit is shared infrastructure — deploy ONE instance, point all
# Stations at it via the same API and public endpoints.
LIVEKIT_API_URL=http://<livekit-host>:7880
LIVEKIT_PUBLIC_URL=ws://<livekit-host>:7880
#
# Generate a key-pair: `openssl rand -hex 16` for key, `openssl rand -hex 32` for secret.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Host-side port for LiveKit HTTP/WS. Default 7880.
LIVEKIT_PORT=7880
# Reachable IP LiveKit advertises for media when public STUN discovery is disabled.
LIVEKIT_NODE_IP=<livekit-host>
# Shared TCP/UDP port for WebRTC media.
LIVEKIT_RTC_PORT=7881
# Webhook callback URL — LiveKit posts room lifecycle events here.
# Must be reachable from the LiveKit host. When LiveKit and Station are
# on different machines, set this to the Station's external address.
LIVEKIT_WEBHOOK_URL=http://<station-host>:18080/hooks/livekit
