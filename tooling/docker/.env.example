# Docker deployment environment variables
#
# Setup per remote:
#   cp .env.example .env              # local / default
#   cp .env.example .env.dev-box      # remote: dev-box context
#
# Makefile auto-selects .env.<REMOTE> when REMOTE is set.
# Falls back to .env if the per-remote file doesn't exist.

# Required — JWT signing secret
PEERS_AUTH_SECRET=change-me-to-a-real-secret

# Network mode: "bridge" (default, isolated) or "host" (share host network)
# Use "host" when PG already runs on the remote host.
# NETWORK_MODE=host

# Override PG DSN — if set, entrypoint generates store.docker.yml at startup.
# Leave empty to use the baked-in config from apps/station/app/conf/.
# PEERS_DB_DSN=host=localhost user=peers password=peers dbname=peers_touch port=5432 sslmode=disable TimeZone=Asia/Shanghai

# PostgreSQL (only used by `make docker-infra` / `infra` profile)
POSTGRES_USER=peers
POSTGRES_PASSWORD=peers
POSTGRES_DB=peers_touch
POSTGRES_PORT=5432

# Station
# STATION_HOST — remote IP/hostname. Used by `make dev-web REMOTE=<name>`
# to set PEERS_STATION_URL so Desktop connects to the remote Station.
# STATION_HOST=10.37.118.48
STATION_PORT=18080

# Relay Station (uses a different port to avoid conflict)
RELAY_STATION_PORT=18081
