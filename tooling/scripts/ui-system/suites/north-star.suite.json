        { "id": "rail-no-right-border", "type": "computedStyle", "target": ".sk-rail", "prop": "borderRightWidth", "equals": "0px" },
        { "id": "head-no-bottom-border", "type": "computedStyle", "target": ".sk-feed-head", "prop": "borderBottomWidth", "equals": "0px" },
        { "id": "chats-no-left-border", "type": "computedStyle", "target": ".sk-chats", "prop": "borderLeftWidth", "equals": "0px" },
