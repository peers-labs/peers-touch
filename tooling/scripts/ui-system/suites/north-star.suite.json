      "oracles": [
        { "id": "value-three", "type": "attr", "target": ".sk-slider input[type='range']", "attr": "value", "equals": "3" },
        { "id": "fill-linked", "type": "attr", "target": ".sk-slider input[type='range']", "attr": "style", "contains": "42.8" },
        { "id": "bubble-three", "type": "textEquals", "target": ".sk-slider-bubble", "equals": "3" }
