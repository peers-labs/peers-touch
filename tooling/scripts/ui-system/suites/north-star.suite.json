        { "id": "one-rail", "type": "count", "scope": "global", "target": ".sk-rail", "equals": 1 },
        { "id": "one-feed", "type": "count", "scope": "global", "target": ".sk-feed", "equals": 1 },
        { "id": "one-chats", "type": "count", "scope": "global", "target": ".sk-chats", "equals": 1 },
