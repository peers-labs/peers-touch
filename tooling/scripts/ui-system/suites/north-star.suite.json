      "oracles": [
        { "id": "input-outline-off", "type": "computedStyle", "target": ".sk-chat-search input", "prop": "outlineStyle", "equals": "none" },
        { "id": "host-focus-ring", "type": "computedStyle", "target": ".sk-chat-search", "prop": "boxShadow", "contains": "0px 0px 0px 2px" }
      ],
      "finalizers": []
