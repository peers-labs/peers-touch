{
  "kind": "peers-ui-specimen-suite",
  "capabilityId": "ui.foundation.elements",
  "specRef": "docs/architecture/platform/client/ui-system/specs/runtime.md",
  "specimen": {
    "url": "/?site=frontend-eles&eles=elements",
    "anchor": ".bk-canvas",
    "implementationRefs": [
      "packages/ui/tokens/src/index.ts",
      "packages/ui/tokens/src/expression-candidate.ts",
      "packages/prototypes/shared/ui-system/BaseElementKit.tsx"
    ]
  },
  "entryGate": {
    "url": "/?site=frontend-eles",
    "button": "[data-action-id='view.elements']",
    "target": ".bk-canvas",
    "urlParam": "elements"
  },
  "scenarios": [
    {
      "id": "ui.foundation.elements.colors-bound-to-tokens",
      "title": "颜色板每一行都由真实 var(--pt-*) 绘制，计算色等于 token 解析值",
      "level": "L4_RUNTIME",
      "operations": [],
      "oracles": [
        { "id": "every-color-paints-from-token", "type": "paintedFromToken", "target": "[data-section='color'] .bk-swatch-row" },
        { "id": "color-rows-present", "type": "count", "target": "[data-section='color'] .bk-swatch-row", "gte": 20 },
        { "id": "resolved-values-populated", "type": "count", "scope": "global", "target": ".bk-swatch-row [data-resolved-value]", "gte": 20 }
      ],
      "finalizers": []
    },
    {
      "id": "ui.foundation.elements.radius-active-scale",
      "title": "圆角读 active token：xs/sm/md/lg/xl/full=4/6/8/12/16/999，纠正旧的 xl=14",
      "level": "L4_RUNTIME",
      "operations": [],
      "oracles": [
        { "id": "radius-paints-from-token", "type": "paintedFromToken", "target": "[data-section='geometry'] .bk-geom-row:has(.bk-radius-demo)" },
        { "id": "radius-xl-is-16", "type": "resolvedText", "scope": "global", "target": "[data-token-role='--pt-radius-xl'] [data-resolved-value]", "equals": "16px" },
        { "id": "radius-full-is-999", "type": "resolvedText", "scope": "global", "target": "[data-token-role='--pt-radius-full'] [data-resolved-value]", "equals": "999px" }
      ],
      "finalizers": []
    },
    {
      "id": "ui.foundation.elements.shadows-bound",
      "title": "三档静息阴影由 var(--pt-shadow-*) 绘制",
      "level": "L4_RUNTIME",
      "operations": [],
      "oracles": [
        { "id": "shadows-paint-from-token", "type": "paintedFromToken", "target": "[data-section='geometry'] .bk-geom-row:has(.bk-shadow-demo)" },
        { "id": "three-shadows", "type": "count", "target": "[data-token-role^='--pt-shadow-']", "gte": 3 }
      ],
      "finalizers": []
    },
    {
      "id": "ui.foundation.elements.spacing-control-bound",
      "title": "间距与控件高度由 active token 度量",
      "level": "L4_RUNTIME",
      "operations": [],
      "oracles": [
        { "id": "space-bars-from-token", "type": "paintedFromToken", "target": ".bk-space-chip" },
        { "id": "control-bars-from-token", "type": "paintedFromToken", "target": ".bk-control-chip" },
        { "id": "seven-space-steps", "type": "count", "target": ".bk-space-chip", "equals": 7 },
        { "id": "three-control-sizes", "type": "count", "target": ".bk-control-chip", "equals": 3 }
      ],
      "finalizers": []
    },
    {
      "id": "ui.foundation.elements.typography-from-components",
      "title": "字阶由真实 Heading/Paragraph/Text 组件承载，不再发明 type token",
      "level": "L4_RUNTIME",
      "operations": [],
      "oracles": [
        { "id": "five-type-roles", "type": "count", "target": "[data-section='type'] .bk-type-row", "equals": 5 },
        { "id": "real-heading-present", "type": "exists", "target": "[data-section='type'] h2.pt-heading" },
        { "id": "real-paragraph-present", "type": "exists", "target": "[data-section='type'] p.pt-paragraph" },
        { "id": "mono-code-present", "type": "exists", "target": "[data-section='type'] code.pt-text" }
      ],
      "finalizers": []
    },
    {
      "id": "ui.foundation.elements.draft-marked-separately",
      "title": "Draft 表达色归入 --as-* 组，不伪装成 --pt-* 宪法 token",
      "level": "L2_VISUAL",
      "operations": [],
      "oracles": [
        { "id": "draft-group-present", "type": "textContains", "scope": "global", "target": "[data-section='color']", "contains": "Draft 表达" },
        { "id": "accent-resolves-as-color", "type": "resolvedText", "scope": "global", "target": "[data-token-role='--as-accent'] [data-resolved-value]", "contains": "rgb" },
        { "id": "selection-resolves-as-gradient", "type": "resolvedText", "scope": "global", "target": "[data-token-role='--as-selection'] [data-resolved-value]", "contains": "linear-gradient" },
        { "id": "draft-row-count", "type": "count", "target": "[data-token-role^='--as-']", "gte": 3 }
      ],
      "finalizers": []
    }
  ]
}
