{
  "kind": "peers-ui-specimen-suite",
  "capabilityId": "ui.spec.button",
  "specRef": "docs/architecture/platform/client/ui-system/button-spec.md",
  "specimen": {
    "url": "/?site=frontend-eles&eles=basics",
    "anchor": "#foundation-ui-spec-button",
    "implementationRefs": [
      "packages/ui/web/src/actions.tsx",
      "packages/ui/web/src/overlays.tsx",
      "packages/ui/semantics/src/index.ts",
      "packages/prototypes/shared/ui-system/ButtonContractSpecimen.tsx"
    ]
  },
  "scenarios": [
    {
      "id": "ui.spec.button.case.01",
      "title": "保存配置 · pending 真连点只产生一次意图，成功后草稿保留",
      "level": "L3_DYNAMIC",
      "operations": [
        { "op": "click", "target": "[data-action-id='bc.save.reset']" },
        { "op": "type", "target": ".bc-draft", "value": "验收草稿ABC" },
        { "op": "click", "target": "[data-action-id='bc.save.run']" },
        { "op": "expect", "id": "pending-marks-unavailable", "oracle": { "type": "attr", "target": "[data-action-id='bc.save.run']", "attr": "aria-disabled", "equals": "true" } },
        { "op": "focus", "target": "[data-action-id='bc.save.run']" },
        { "op": "press", "key": "Enter" },
        { "op": "wait", "ms": 800 }
      ],
      "oracles": [
        { "id": "single-intent-on-repeat-activate", "type": "textContains", "target": "[data-spec-case='B01'] .fs-notice", "contains": "激活计数=1" },
        { "id": "draft-not-cleared", "type": "attr", "target": ".bc-draft", "attr": "value", "contains": "验收草稿ABC" },
        { "id": "owner-success-label", "type": "textContains", "target": "[data-action-id='bc.save.run']", "contains": "已保存" }
      ],
      "finalizers": []
    },
    {
      "id": "ui.spec.button.case.02",
      "title": "停止输出 · running→stopping→stopped，不等于完成",
      "level": "L3_DYNAMIC",
      "operations": [
        { "op": "click", "target": "[data-action-id='bc.stop']" },
        { "op": "wait", "ms": 800 }
      ],
      "oracles": [
        { "id": "stopped-terminal-label", "type": "textEquals", "target": "[data-action-id='bc.stop']", "equals": "已停止" },
        { "id": "cancel-is-separate-action", "type": "exists", "target": "[data-action-id='bc.cancel']" }
      ],
      "finalizers": []
    },
    {
      "id": "ui.spec.button.case.03",
      "title": "删除对象 · 具名范围确认面内为 primary/danger",
      "level": "L3_DYNAMIC",
      "operations": [
        { "op": "click", "target": "[data-action-id='bc.delete.open']" },
        { "op": "waitFor", "scope": "global", "target": ".pt-dialog", "state": "visible" }
      ],
      "oracles": [
        { "id": "named-scope-in-dialog", "type": "textContains", "scope": "global", "target": ".pt-dialog", "contains": "删除会话「项目讨论」" },
        { "id": "confirm-danger-primary", "type": "attr", "scope": "global", "target": ".pt-dialog [data-action-id='bc.delete.confirm']", "attr": "data-tone", "equals": "danger" }
      ],
      "finalizers": [{ "op": "clickGlobal", "target": ".pt-dialog [data-action-id='bc.delete.confirm.cancel']" }]
    },
    {
      "id": "ui.spec.button.case.04a",
      "title": "SplitButton 主区只触发默认动作",
      "level": "L3_DYNAMIC",
      "operations": [
        { "op": "click", "target": "[data-action-id='bc.send']" }
      ],
      "oracles": [
        { "id": "default-fired-once", "type": "textContains", "target": "[data-split-observer]", "contains": "默认发送=1" },
        { "id": "no-alternative-picked", "type": "textContains", "target": "[data-split-observer]", "contains": "变体选择=无" }
      ],
      "finalizers": []
    },
    {
      "id": "ui.spec.button.case.04b",
      "title": "SplitButton 菜单变体不代发默认动作",
      "level": "L3_DYNAMIC",
      "operations": [
        { "op": "click", "target": "[data-action-id='bc.send.alternatives']" },
        { "op": "waitFor", "scope": "global", "target": ".pt-menu [role='menuitem']", "state": "visible" },
        { "op": "clickGlobal", "target": ".pt-menu [role='menuitem']:has-text('定时发送')" },
        { "op": "wait", "ms": 150 }
      ],
      "oracles": [
        { "id": "alternative-recorded", "type": "textContains", "target": "[data-split-observer]", "contains": "scheduled" },
        { "id": "default-not-fired-from-menu", "type": "textContains", "target": "[data-split-observer]", "contains": "默认发送=0" }
      ],
      "finalizers": []
    },
    {
      "id": "ui.spec.button.b06.retry",
      "title": "重试失败 · 首次失败保留对象，恢复走同一意图",
      "level": "L3_DYNAMIC",
      "operations": [
        { "op": "click", "target": "[data-action-id='bc.redeliver.run']" },
        { "op": "waitFor", "target": "[data-action-id='bc.redeliver.retry']", "state": "visible" },
        {
          "op": "expect",
          "id": "retry-affordance-on-failure",
          "oracle": { "type": "visible", "target": "[data-action-id='bc.redeliver.retry']" }
        },
        { "op": "click", "target": "[data-action-id='bc.redeliver.retry']" },
        { "op": "wait", "ms": 800 }
      ],
      "oracles": [
        { "id": "recovered-same-intent-second-attempt", "type": "textContains", "target": "[data-spec-case='B06'] .fs-notice", "contains": "attempts=2" }
      ],
      "finalizers": []
    },
    {
      "id": "ui.spec.button.b07.copy",
      "title": "复制 · 短暂成功反馈且按钮宽度不跳变",
      "level": "L3_DYNAMIC",
      "operations": [],
      "oracles": [
        { "id": "copied-feedback-with-stable-width", "type": "widthStableOnActivate", "target": "[data-action-id='bc.copy']" },
        { "id": "shows-copied-label-after-activation", "type": "textContains", "scope": "global", "target": "[data-action-id='bc.copy']", "contains": "已复制" }
      ],
      "finalizers": []
    },
    {
      "id": "ui.spec.button.b19.reason-readable",
      "title": "不可用需解释 · 原因由组件自身经 aria-describedby 暴露，控件保持可聚焦",
      "level": "L4_RUNTIME",
      "operations": [],
      "oracles": [
        { "id": "marked-unavailable", "type": "disabled", "target": "[data-action-id='bc.permission.grant']" },
        { "id": "native-disabled-not-used", "type": "nativeDisabledAbsent", "target": "[data-action-id='bc.permission.grant']" },
        { "id": "remains-focusable", "type": "focusable", "target": "[data-action-id='bc.permission.grant']" },
        { "id": "reason-via-describedby", "type": "describedByText", "target": "[data-action-id='bc.permission.grant']", "contains": "需要先连接 Station" }
      ],
      "finalizers": [],
      "screenshots": [{ "file": "b19-reason.png" }]
    },
    {
      "id": "ui.spec.button.b19.keyboard-blocked",
      "title": "不可用控件上键盘激活被组件拦截，不会静默执行",
      "level": "L4_RUNTIME",
      "operations": [
        { "op": "focus", "target": "[data-action-id='bc.permission.grant']" },
        { "op": "press", "key": "Enter" }
      ],
      "oracles": [
        { "id": "recovery-entry-still-offered", "type": "visible", "target": "[data-action-id='bc.permission.connect']" },
        { "id": "grant-still-unavailable", "type": "disabled", "target": "[data-action-id='bc.permission.grant']" }
      ],
      "finalizers": []
    },
    {
      "id": "ui.spec.button.b19.recovery-path",
      "title": "连接 Station 后同一动作恢复可用",
      "level": "L3_DYNAMIC",
      "operations": [
        { "op": "click", "target": "[data-action-id='bc.permission.connect']" },
        { "op": "wait", "ms": 150 }
      ],
      "oracles": [
        { "id": "grant-enabled-after-connect", "type": "enabled", "target": "[data-action-id='bc.permission.grant']" }
      ],
      "finalizers": []
    },
    {
      "id": "ui.spec.button.focus-visible",
      "title": "键盘焦点可见",
      "level": "L4_RUNTIME",
      "operations": [ { "op": "focus", "target": "[data-action-id='bc.add']" } ],
      "oracles": [
        { "id": "focus-visible-ring", "type": "focusVisible", "target": "[data-action-id='bc.add']" }
      ],
      "finalizers": []
    },
    {
      "id": "ui.spec.button.anti.primary-uniqueness",
      "title": "反例：两个无关 primary 均不可激活（不是有效主承诺）",
      "level": "L3_DYNAMIC",
      "operations": [],
      "oracles": [
        { "id": "anti-primary-a-unavailable", "type": "attr", "target": "[data-action-id='bc.anti.primary1']", "attr": "aria-disabled", "equals": "true" },
        { "id": "anti-primary-b-unavailable", "type": "attr", "target": "[data-action-id='bc.anti.primary2']", "attr": "aria-disabled", "equals": "true" }
      ],
      "finalizers": []
    }
  ]
}
