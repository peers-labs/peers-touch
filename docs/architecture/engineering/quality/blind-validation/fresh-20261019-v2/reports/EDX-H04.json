      },
      "clause": "MCA-D20 catalog verification",
      "statement": "Package discovery consumes signed versioned snapshots whose pinned source identity, signature, schema, artifact hash, trust, derived risk, scan verdict, and install policy are verified before publication."
    },
    {
      "id": "C-H04-AUTHORITY-READBACK",
      "authority": "accepted-product",
      "caseCoverage": "supporting",
      "source": {
        "path": "docs/architecture/domains/agent/modern-chat-agent/decisions.md",
        "lineStart": 1612,
        "lineEnd": 1622
      },
      "clause": "MCA-D20 authority-specific installation",
      "statement": "Agent, Skill, and MCP packages install through their target authority and require authority readback; the local ledger is only a reconciliation cache."
    },
    {
      "id": "C-H04-RISK-AND-REVOCATION",
      "authority": "accepted-product",
      "caseCoverage": "explicit",
      "source": {
        "path": "docs/architecture/domains/agent/modern-chat-agent/decisions.md",
        "lineStart": 1624,
        "lineEnd": 1629
      },
      "clause": "MCA-D20 risk and revocation",
      "statement": "Revocation blocks new install and update without deleting user-owned resources, high-risk packages require explicit confirmation before mutation, and invalid or blocked inputs fail closed."
    },
    {
      "id": "C-H04-STALE-SOURCE",
      "authority": "accepted-product",
      "caseCoverage": "explicit",
      "source": {
        "path": "docs/architecture/domains/agent/modern-chat-agent/decisions.md",
        "lineStart": 1656,
        "lineEnd": 1668
      },
      "clause": "MCA-D20 consequences",
      "statement": "Catalog APIs expose provenance, revocation, derived policy, and pagination; network failure may retain the last verified snapshot only when stale or error state is visible."
    },
    {
      "id": "C-H04-VISIBLE-ACCEPTANCE",
      "authority": "accepted-product",
      "caseCoverage": "explicit",
      "source": {
        "path": "tooling/acceptance/features/agent-trusted-package-catalog.yaml",
        "lineStart": 31,
        "lineEnd": 45
      },
      "clause": "visible acceptance",
      "statement": "Marketplace visibly shows source trust, signature, package type, version, derived risk, scan verdict, install policy, and revocation; high risk requires confirmation and revoked packages remain inspectable but cannot be installed."
    },
    {
      "id": "C-H04-NEGATIVE-GUARDS",
      "authority": "accepted-product",
      "caseCoverage": "supporting",
      "source": {
        "path": "tooling/acceptance/features/agent-trusted-package-catalog.yaml",
        "lineStart": 47,
        "lineEnd": 55
      },
      "clause": "negative acceptance",
      "statement": "Source labels do not become authority, install success does not precede target-authority readback, revocation does not silently delete installed resources, and static evidence is not native proof."
    }
