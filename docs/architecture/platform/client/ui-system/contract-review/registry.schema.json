{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Peers UI isolated contract review input",
  "description": "Closed proposal shape only. Does not establish Owner acceptance, implementation, or product evidence.",
  "type": "object",
  "properties": {
    "kind": {
      "enum": [
        "peers-ui-typed-contract-review-registry"
      ]
    },
    "status": {
      "enum": [
        "PROPOSED"
      ]
    },
    "claimScope": {
      "enum": [
        "TYPED_CONSTRAINT_AND_MAPPING_REVIEW_ONLY"
      ]
    },
    "sourceBasisRef": {
      "type": "string",
      "minLength": 1
    },
    "sourceBasisDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "catalogBindings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "catalogId": {
            "type": "string",
            "minLength": 1
          },
          "contractId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "catalogId",
          "contractId"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "ports": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/port"
      },
      "minItems": 1
    },
    "contracts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contract"
      },
      "minItems": 1
    }
  },
  "required": [
    "kind",
    "status",
    "claimScope",
    "sourceBasisRef",
    "sourceBasisDigest",
    "catalogBindings",
    "ports",
    "contracts"
  ],
  "additionalProperties": false,
  "$defs": {
    "expression": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "field"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "literal": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          },
          "required": [
            "literal"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "eq",
                "ne",
                "lte",
                "gte",
                "gt",
                "and",
                "or",
                "implies"
              ]
            },
            "args": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expression"
              },
              "minItems": 2
            }
          },
          "required": [
            "op",
            "args"
          ],
          "additionalProperties": false
        }
      ]
    },
    "inputField": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "boolean"
              ]
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "number"
              ]
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "integer"
              ]
            },
            "minimum": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "type",
            "minimum"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "enum"
              ]
            },
            "values": {
              "type": "array",
              "items": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              "minItems": 1
            }
          },
          "required": [
            "type",
            "values"
          ],
          "additionalProperties": false
        }
      ]
    },
    "axis": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "enum",
            "set",
            "policy-ref",
            "range-policy",
            "precision-policy",
            "limits-policy",
            "display-cap-policy",
            "bounds-policy",
            "token-ref",
            "breakpoint-policy",
            "deadline-policy",
            "impact-policy",
            "port-set"
          ]
        },
        "allowedValues": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "number"
            ]
          },
          "minItems": 0
        },
        "requiredFields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "defaultPolicy": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "literal",
                "owner-projection",
                "required-or-derived"
              ]
            },
            "value": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "array",
                  "items": {
                    "type": [
                      "string",
                      "number"
                    ]
                  },
                  "minItems": 0
                }
              ]
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        "inputClass": {
          "enum": [
            "READ_ONLY_PROJECTION",
            "OWNER_POLICY",
            "CONFIGURATION"
          ]
        },
        "draftSource": {
          "type": "object",
          "properties": {
            "specificationId": {
              "type": "string",
              "minLength": 1
            },
            "field": {
              "enum": [
                "variantAxes"
              ]
            },
            "ordinal": {
              "type": "integer",
              "minimum": 0
            },
            "text": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "specificationId",
            "field",
            "ordinal",
            "text"
          ],
          "additionalProperties": false
        },
        "normalization": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "PROPOSED"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "type",
        "allowedValues",
        "requiredFields",
        "defaultPolicy",
        "inputClass",
        "draftSource",
        "normalization",
        "status"
      ],
      "additionalProperties": false
    },
    "constraint": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "expr": {
          "$ref": "#/$defs/expression"
        },
        "origin": {
          "type": "object",
          "properties": {
            "specRef": {
              "type": "string",
              "minLength": 1
            },
            "field": {
              "type": "string",
              "minLength": 1
            },
            "sourceText": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "specRef",
            "field",
            "sourceText"
          ],
          "additionalProperties": false
        },
        "scope": {
          "enum": [
            "BOUNDED_TYPED_PROJECTION"
          ]
        },
        "semanticAcceptance": {
          "enum": [
            "UNPROVEN"
          ]
        }
      },
      "required": [
        "id",
        "description",
        "expr",
        "origin",
        "scope",
        "semanticAcceptance"
      ],
      "additionalProperties": false
    },
    "transition": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "event": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "authority": {
          "enum": [
            "UI_INTENT_ONLY",
            "OWNER_PROJECTION",
            "DRAFT_OWNER",
            "UI_PRESENTATION",
            "PORT_OBSERVATION"
          ]
        }
      },
      "required": [
        "from",
        "event",
        "to",
        "authority"
      ],
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "command",
            "field",
            "overlay",
            "disclosure",
            "resource",
            "domain",
            "passive",
            "projection",
            "navigation",
            "manipulation",
            "collection",
            "environment"
          ]
        },
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "initial": {
          "type": "string",
          "minLength": 1
        },
        "states": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "events": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "transitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transition"
          },
          "minItems": 1
        },
        "projectionEnums": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "origin": {
                "enum": [
                  "DRAFT_ENUM_NOT_DOMAIN_PROTOCOL"
                ]
              },
              "transitionAuthority": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "name",
              "values",
              "origin",
              "transitionAuthority"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "notApplicable": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "coverage": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "PROPOSED"
          ]
        }
      },
      "required": [
        "kind",
        "authority",
        "initial",
        "states",
        "events",
        "transitions",
        "projectionEnums",
        "notApplicable",
        "coverage",
        "status"
      ],
      "additionalProperties": false
    },
    "assertion": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "observable": {
          "type": "string",
          "minLength": 1
        },
        "requiredInputFields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "predicateRef": {
          "type": "string",
          "minLength": 1
        },
        "levels": {
          "type": "array",
          "items": {
            "enum": [
              "L2_VISUAL",
              "L3_DYNAMIC",
              "L4_RUNTIME"
            ]
          },
          "minItems": 1
        },
        "probeRef": {
          "type": "null"
        },
        "probeStatus": {
          "enum": [
            "NOT_BOUND"
          ]
        },
        "forbiddenSubstitute": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "subject",
        "observable",
        "requiredInputFields",
        "predicateRef",
        "levels",
        "probeRef",
        "probeStatus",
        "forbiddenSubstitute"
      ],
      "additionalProperties": false
    },
    "scenario": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "selectionRationale": {
          "type": "string",
          "minLength": 1
        },
        "expectedUserEffect": {
          "type": "string",
          "minLength": 1
        },
        "recoveryRequirement": {
          "type": "string",
          "minLength": 1
        },
        "structuredAssertionRef": {
          "type": "string",
          "minLength": 1
        },
        "bindingStatus": {
          "enum": [
            "NEEDS_CASE_SPECIFIC_OPERATION_ORACLE_AND_FINALIZER"
          ]
        },
        "operationRef": {
          "type": "null"
        },
        "oracleRef": {
          "type": "null"
        },
        "finalizerRef": {
          "type": "null"
        },
        "implementationRef": {
          "type": "null"
        },
        "evidenceStatus": {
          "enum": [
            "UNPROVEN"
          ]
        }
      },
      "required": [
        "id",
        "title",
        "selectionRationale",
        "expectedUserEffect",
        "recoveryRequirement",
        "structuredAssertionRef",
        "bindingStatus",
        "operationRef",
        "oracleRef",
        "finalizerRef",
        "implementationRef",
        "evidenceStatus"
      ],
      "additionalProperties": false
    },
    "contract": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "capability": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": [
            "action",
            "input",
            "identity",
            "feedback",
            "content",
            "layout",
            "disclosure",
            "navigation",
            "overlay",
            "media",
            "code",
            "runtime",
            "domain"
          ]
        },
        "catalogIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "publicSymbolRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "specRef": {
          "type": "string",
          "minLength": 1
        },
        "basisRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "status": {
          "type": "object",
          "properties": {
            "contract": {
              "enum": [
                "DRAFT"
              ]
            },
            "review": {
              "enum": [
                "PENDING_OWNER_REVIEW"
              ]
            },
            "implementation": {
              "enum": [
                "NOT_IMPLEMENTED"
              ]
            },
            "specimen": {
              "enum": [
                "NOT_BUILT"
              ]
            },
            "usefulnessEvidence": {
              "enum": [
                "UNPROVEN"
              ]
            }
          },
          "required": [
            "contract",
            "review",
            "implementation",
            "specimen",
            "usefulnessEvidence"
          ],
          "additionalProperties": false
        },
        "owner": {
          "type": "object",
          "properties": {
            "role": {
              "type": "string",
              "minLength": 1
            },
            "ownerRef": {
              "type": "null"
            },
            "assignment": {
              "enum": [
                "OWNER_UNASSIGNED"
              ]
            },
            "boundarySource": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "role",
            "ownerRef",
            "assignment",
            "boundarySource"
          ],
          "additionalProperties": false
        },
        "axes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/axis"
          },
          "minItems": 2
        },
        "evaluationInput": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[A-Za-z][A-Za-z0-9]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/inputField"
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/constraint"
          },
          "minItems": 1
        },
        "stateModel": {
          "$ref": "#/$defs/state"
        },
        "ports": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "observableAssertions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assertion"
          },
          "minItems": 1
        },
        "scenarios": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scenario"
          },
          "minItems": 4
        },
        "retainedHumanReview": {
          "type": "object",
          "properties": {
            "anatomy": {
              "type": "string",
              "minLength": 1
            },
            "accessibility": {
              "type": "string",
              "minLength": 1
            },
            "geometry": {
              "type": "string",
              "minLength": 1
            },
            "extremeData": {
              "type": "string",
              "minLength": 1
            },
            "lifecycle": {
              "type": "string",
              "minLength": 1
            },
            "publicApiShape": {
              "type": "string",
              "minLength": 1
            },
            "interpretation": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "anatomy",
            "accessibility",
            "geometry",
            "extremeData",
            "lifecycle",
            "publicApiShape",
            "interpretation"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "capability",
        "category",
        "catalogIds",
        "publicSymbolRefs",
        "specRef",
        "basisRefs",
        "status",
        "owner",
        "axes",
        "evaluationInput",
        "constraints",
        "stateModel",
        "ports",
        "observableAssertions",
        "scenarios",
        "retainedHumanReview"
      ],
      "additionalProperties": false
    },
    "port": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "enum": [
            "intent+projection",
            "draft+commit-intent",
            "observation+capability"
          ]
        },
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "requestFields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "responseFields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "failureKinds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "noVendorTypes": {
          "const": true
        },
        "implementationRef": {
          "type": "null"
        },
        "status": {
          "enum": [
            "PROPOSED_NOT_BOUND"
          ]
        }
      },
      "required": [
        "id",
        "direction",
        "authority",
        "requestFields",
        "responseFields",
        "failureKinds",
        "noVendorTypes",
        "implementationRef",
        "status"
      ],
      "additionalProperties": false
    }
  }
}
